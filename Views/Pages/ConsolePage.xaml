<Page x:Class="Modrix.Views.Pages.ConsolePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Modrix.Views.Controls"
      mc:Ignorable="d"
      Title="ConsolePage">

    <Page.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2" Opacity="0.10"/>
    </Page.Resources>

    <Grid>
        <StackPanel>
            <!-- Page Header -->
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="3,3,18,18" Padding="0,0,0,18" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" Margin="32,10,32,0" VerticalAlignment="Center">
                    <ui:Image Source="pack://application:,,,/Resources/Icons/ConsoleIcon.png" Width="40" Height="40" Margin="0,0,16,0"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Console" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <controls:WikiTooltip 
                                WikiId="gradle-console-output"
                                Title="Understanding Console Output"
                                Category="Tools"
                                Keywords="console,gradle,build,output,errors,debugging"
                                Description="The console shows real-time output from Gradle builds and Minecraft runs. Green text usually indicates success, red indicates errors, and yellow shows warnings. Use this to debug build issues, track mod loading, and monitor performance."
                                Margin="8,5,0,0"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="View build output and runtime logs" FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Main Content Card -->
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="12" Padding="0" Margin="32,0,32,32" Effect="{StaticResource CardShadow}">
                <DockPanel LastChildFill="True">
                    <!-- Toolbar fixed at top -->
                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="12,12,12,8">
                        <CheckBox x:Name="ChkLineIndex"
                                  Content="Show Line Index"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  Checked="ChkLineIndex_Changed"
                                  Unchecked="ChkLineIndex_Changed"/>
                        <CheckBox x:Name="ChkAutoScroll"
                                  Content="Auto Scroll"
                                  IsChecked="True"
                                  Margin="0,0,16,0"
                                  VerticalAlignment="Center"
                                  Checked="ChkAutoScroll_Changed"
                                  Unchecked="ChkAutoScroll_Changed"/>
                        <controls:WikiTooltip 
                            WikiId="console-auto-scroll"
                            Title="Auto Scroll Feature"
                            Category="Tools"
                            Keywords="auto scroll,console,output,real-time"
                            Description="Auto scroll automatically scrolls to the bottom of the console as new output appears. This is useful for monitoring builds in real-time. Disable it if you want to read earlier output without being interrupted."
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"/>
                        <ui:Button Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Copy24}"
                                   ToolTip="Copy All"
                                   Margin="0,0,8,0"
                                   Click="CopyButton_Click"/>
                        <ui:Button Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Share24}"
                                   ToolTip="Share Log"
                                   Margin="0,0,8,0"
                                   Click="ShareButton_Click"/>
                        <ui:Button Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   ToolTip="Clear Console"
                                   Click="ClearButton_Click"/>
                    </StackPanel>

                    <!-- Console Output -->
                    <Border Background="Black" CornerRadius="8" Margin="8,8,8,8">
                        <RichTextBox x:Name="ConsoleOutput"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     Foreground="White"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     Height="500"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="8"/>
                    </Border>
                </DockPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
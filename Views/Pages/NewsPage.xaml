<Page
    x:Class="Modrix.Views.Pages.NewsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="clr-namespace:Modrix.Helpers"
    xmlns:md="http://schemas.lepo.co/wpfui/2022/xaml/markdown"
    mc:Ignorable="d"
    Title="NewsPage"
    d:DesignHeight="600"
    d:DesignWidth="900"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <md:ThemesDictionary Theme="Light" />
                <md:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <helpers:EmptyCollectionToVisibilityConverter x:Key="EmptyCollectionToVisibilityConverter"/>

            <!-- Effects -->
            <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Opacity="0.18"/>

            <!-- Commit Item Template -->
            <DataTemplate x:Key="CommitItemTemplate">
                <Border CornerRadius="10" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="0" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Accent gradient bar -->
                        <Border Grid.Column="0" CornerRadius="10,0,0,10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#4C7DFF" Offset="0"/>
                                    <GradientStop Color="#2850B7" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Commit Content -->
                        <StackPanel Grid.Column="1" Margin="16,14,12,14">
                            <md:MarkdownViewer Markdown="{Binding Message}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                                <ui:SymbolIcon Symbol="Person24" Width="18" Height="18" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Author}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <ui:Button Width="40" Height="40" Appearance="Secondary" ToolTip="Open on GitHub" Icon="{ui:SymbolIcon Open24}"
                                       Command="{Binding DataContext.OpenCommitCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       CommandParameter="{Binding Url}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <!-- No Internet State -->
        <Grid x:Name="NoInternetGrid" Visibility="Collapsed" Background="Transparent">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:Image Source="pack://application:,,,/Resources/Icons/NoWifiIcon.png"
                          Width="120"
                          Height="120"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="No Internet Connection"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
                <TextBlock Text="Please check your network and try again."
                           FontSize="14"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <ScrollViewer x:Name="ContentScrollViewer" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,32">
                <!-- Page Header -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="3,3,18,18" Padding="0,0,0,18" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" Margin="32,10,32,0" VerticalAlignment="Center">
                        <ui:Image Source="pack://application:,,,/Resources/Icons/NewsIcon.png" Width="40" Height="40" Margin="0,0,16,0"/>
                        <StackPanel>
                            <TextBlock Text="Modrix News" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="Latest updates and development activity" FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Commits Card -->
                <ui:Card Margin="32,0,32,0" Padding="24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                            <ui:Image Source="pack://application:,,,/Resources/Icons/ModrixGitHub.png" Width="28" Height="28" Margin="0,0,8,0"/>
                            <TextBlock Text="Latest Commits" FontSize="20" FontWeight="SemiBold"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding LatestCommits}" ItemTemplate="{StaticResource CommitItemTemplate}"/>

                        <TextBlock Text="No recent commits found." FontStyle="Italic" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding LatestCommits.Count, Converter={StaticResource EmptyCollectionToVisibilityConverter}}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
<Page
    x:Class="Modrix.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:Modrix.Helpers"
    xmlns:local="clr-namespace:Modrix.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Modrix.Views.Controls"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:converters="clr-namespace:Modrix.Helpers"
    xmlns:models="clr-namespace:Modrix.Models"
    xmlns:vm="clr-namespace:Modrix.ViewModels.Pages"
    Title="SettingsPage"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}"
    d:DesignHeight="600"
    d:DesignWidth="900"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <helpers:BytesToMegabytesConverter x:Key="BytesToMegabytesConverter" />
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
        <ObjectDataProvider x:Key="LineEndingTypes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:LineEndingType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,32">
            <!-- Page Header -->
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="3,3,18,18" Padding="0,0,0,18" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" Margin="32,10,32,0" VerticalAlignment="Center">
                    <ui:Image Source="pack://application:,,,/Resources/Icons/SettingsIcon.png" Width="40" Height="40" Margin="0,0,16,0"/>
                    <StackPanel>
                        <TextBlock Text="Settings" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Personalize your Modrix experience" FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Personalization Section (enhanced) -->
            <ui:Card Margin="32,0,32,18" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="Color24" Width="28" Height="28" Margin="0,0,8,0"/>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Personalization"/>
                    </StackPanel>

                    <!-- Theme selector panel -->
                    <Border CornerRadius="10" Background="{DynamicResource ControlFillColorSecondaryBrush}" Margin="0,0,0,0">
                        <Border.Resources>
                            <!-- Style for theme chips moved before content -->
                            <Style TargetType="RadioButton" x:Key="ThemeChipRadio">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="Chip" Padding="14,8" Margin="0,0,10,10" CornerRadius="18" Background="#2F3037" BorderBrush="#43454F" BorderThickness="1" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ContentPresenter/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chip" Property="Background" Value="#4C7DFF"/>
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="#4C7DFF"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="#6B89FF"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Chip" Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Style>
                        </Border.Resources>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Accent -->
                            <Border Grid.Column="0" CornerRadius="10,0,0,10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#9C6BFF" Offset="0"/>
                                        <GradientStop Color="#6A46C8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,14,16,16">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Color24" Width="20" Height="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="14"/>
                                </StackPanel>

                                <WrapPanel>
                                    <RadioButton Style="{StaticResource ThemeChipRadio}"
                                                 Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
                                                 CommandParameter="theme_light"
                                                 Content="Light"
                                                 Foreground="White"
                                                 GroupName="themeSelect"
                                                 IsChecked="{Binding ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light, Mode=OneWay}" />
                                    <RadioButton Style="{StaticResource ThemeChipRadio}"
                                                 Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
                                                 CommandParameter="theme_dark"
                                                 Content="Dark"
                                                 GroupName="themeSelect"
                                                 Foreground="White"
                                                 IsChecked="{Binding ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark, Mode=OneWay}" />
                                    <RadioButton Style="{StaticResource ThemeChipRadio}"
                                                 Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
                                                 CommandParameter="theme_highcontrast"
                                                 Content="High Contrast"
                                                 GroupName="themeSelect"
                                                 Foreground="White"
                                                 IsChecked="{Binding ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=HighContrast, Mode=OneWay}" />
                                </WrapPanel>

                                <TextBlock Text="Choose how Modrix looks and feels." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ui:Card>

            <!-- Workspace Section -->
            <ui:Card Margin="32,0,32,18" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="Desktop24" Width="28" Height="28" Margin="0,0,8,0"/>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Workspace"/>
                    </StackPanel>

                    <!-- On Open Settings (enhanced) -->
                    <Border Margin="0,0,0,18" CornerRadius="10" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="10,0,0,10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#4C7DFF" Offset="0"/>
                                        <GradientStop Color="#2850B7" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,14,16,14">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="ArrowTrendingLines24" Width="20" Height="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="On Open" FontWeight="SemiBold" FontSize="14"/>
                                </StackPanel>
                                <ui:ToggleSwitch Content="Close Main Window" IsChecked="{Binding ViewModel.IdeSettings.CloseMainWindowOnOpen}"/>
                                <DockPanel Margin="0,10,0,0">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Navigate to Tab" FontWeight="Medium"/>
                                        <TextBlock Text="Automatically open a specific workspace tab." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox Margin="16,0,0,0"
                                              ItemsSource="{Binding ViewModel.AvailableTabs}"
                                              SelectedItem="{Binding ViewModel.IdeSettings.OnOpenNavigateTab}"
                                              Width="170"
                                              VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- IDE Settings heading visually integrated -->
                    <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="IDE Settings" />

                    <!-- Combined IDE settings grid style panels -->
                    <UniformGrid Columns="2" Margin="0,0,0,4" HorizontalAlignment="Stretch">
                        <!-- Editor Preferences -->
                        <Border Margin="0,0,8,8" CornerRadius="10" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="Edit24" Width="20" Height="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="Editor" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="Word Wrap" VerticalAlignment="Center"/>
                                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.IdeSettings.WordWrap}" HorizontalAlignment="Right" Width="52"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Use Spaces for Tabs" VerticalAlignment="Center"/>
                                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.IdeSettings.UseSpacesForTabs}" HorizontalAlignment="Right" Width="52"/>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Visual Preferences -->
                        <Border Margin="8,0,0,8" CornerRadius="10" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="Eye24" Width="20" Height="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="Visual" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Line Numbers" VerticalAlignment="Center"/>
                                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.IdeSettings.ShowLineNumbers}" HorizontalAlignment="Right" Width="52"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Whitespace" VerticalAlignment="Center"/>
                                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.IdeSettings.ShowWhitespace}" HorizontalAlignment="Right" Width="52"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Line Endings" VerticalAlignment="Center"/>
                                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.IdeSettings.ShowLineEndings}" HorizontalAlignment="Right" Width="52"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Highlight Line" VerticalAlignment="Center"/>
                                        <ui:ToggleSwitch IsChecked="{Binding ViewModel.IdeSettings.HighlightCurrentLine}" HorizontalAlignment="Right" Width="52"/>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- File Handling -->
                    <Border Margin="0,4,0,0" CornerRadius="10" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ui:SymbolIcon Symbol="SaveEdit24" Width="20" Height="20" Margin="0,0,8,0"/>
                                <TextBlock Text="File Handling" FontWeight="SemiBold"/>
                            </StackPanel>
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="Auto Save"/>
                                    <TextBlock Text="Automatically persist changes." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ui:ToggleSwitch IsChecked="{Binding ViewModel.IdeSettings.AutoSave}" HorizontalAlignment="Right" Width="52"/>
                            </DockPanel>
                            <DockPanel Margin="0,10,0,0" IsEnabled="{Binding ViewModel.IdeSettings.AutoSave}">
                                <StackPanel>
                                    <TextBlock Text="Interval (seconds)"/>
                                    <TextBlock Text="Time between automatic writes." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ui:NumberBox Margin="16,0,0,0" Value="{Binding ViewModel.IdeSettings.AutoSaveIntervalSeconds}" Minimum="5" Maximum="300" MinWidth="90" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:Card>

            <!-- Installation Section -->
            <ui:Card Margin="32,0,32,18" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="ArrowDownload24" Width="28" Height="28" Margin="0,0,8,0"/>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Installation"/>
                    </StackPanel>

                    <!-- Update Section -->
                    <Border Margin="0,0,0,20" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="10" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="10,0,0,10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#4C7DFF" Offset="0"/>
                                        <GradientStop Color="#2850B7" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,14,18,14">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="40" Height="40" CornerRadius="8" Background="#1E2A3E" Margin="0,0,12,0">
                                        <ui:SymbolIcon Symbol="ArrowSync24" Foreground="#4C7DFF" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Updates" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ViewModel.UpdateStatus}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0" Orientation="Horizontal">
                                <ui:Button x:Name="CheckUpdatesButton"
                                         Content="Check for Updates" 
                                         Appearance="Secondary"
                                         Icon="{ui:SymbolIcon ArrowSync24}"
                                         Command="{Binding ViewModel.CheckForUpdatesCommand}"
                                         IsEnabled="{Binding ViewModel.IsCheckingForUpdates, Converter={StaticResource InverseBoolConverter}}"
                                         Margin="0,0,8,0"
                                         Padding="12,8"/>
                                <ui:Button x:Name="InstallUpdateButton"
                                         Content="Install Update" 
                                         Appearance="Primary"
                                         Icon="{ui:SymbolIcon ArrowDownload24}"
                                         Command="{Binding ViewModel.InstallUpdateCommand}"
                                         Visibility="{Binding ViewModel.HasUpdateAvailable, Converter={StaticResource BoolToVisibility}}"
                                         Padding="12,8"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Uninstall Section (visual improvement) -->
                    <Border Margin="0,0,0,20" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="10" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="10,0,0,10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF4D3F" Offset="0"/>
                                        <GradientStop Color="#C52F25" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,14,18,14">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="40" Height="40" CornerRadius="8" Background="#3E1F24" Margin="0,0,12,0">
                                        <ui:SymbolIcon Symbol="Delete24" Foreground="#FF6B5E" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Uninstall Modrix" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="Removes the application. Your projects remain on disk." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:Button Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" Content="Uninstall" Click="Uninstall_Click" ToolTip="Remove Modrix from your system" Padding="16,8"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Java JDKs Section (unchanged) -->
                    <Border Margin="0,0,0,0" Padding="18" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Code24" Width="22" Height="22" Margin="0,0,6,0"/>
                                <TextBlock Text="Java JDKs" FontWeight="Medium" VerticalAlignment="Center"/>
                                <controls:WikiTooltip Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    WikiId="java-jdk"
                                                    Title="What is a Java JDK?"
                                                    Category="Tools"
                                                    Keywords="java,jdk,compiler,development,minecraft"
                                                    Description="A Java Development Kit (JDK) is required to compile and run Minecraft mods. Different Minecraft versions require different Java versions: 1.20.x requires Java 17, while 1.21.x requires Java 21. Modrix can automatically download and manage JDKs for you."/>
                                <ui:Button Margin="12,0,0,0" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding ViewModel.RefreshJdksCommand}" ToolTip="Refresh JDK list" VerticalAlignment="Center"/>
                                <ui:Button Margin="12,0,0,0" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding ViewModel.DownloadJdkCommand}" ToolTip="Download and install a JDK" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding ViewModel.IsInstallingJdk, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding ViewModel.InstallationStatus}" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                <ProgressBar Value="{Binding ViewModel.InstallationProgress}" Minimum="0" Maximum="100" Height="8"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding ViewModel.InstalledJdks}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="12" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Path}" FontWeight="SemiBold"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="Version: " Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding Version}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text=" • " Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding Source}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <ui:Button Command="{Binding DataContext.ViewModel.OpenJdkFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Margin="0,0,8,0" Appearance="Secondary" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Open JDK folder"/>
                                                    <ui:Button Command="{Binding DataContext.ViewModel.RemoveJdkCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" ToolTip="Remove JDK" Visibility="{Binding IsRemovable, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No JDKs detected" Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewModel.InstalledJdks.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:Card>

            <!-- About Section (enhanced) -->
            <ui:Card Margin="32,0,32,0" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="Info24" Width="28" Height="28" Margin="0,0,8,0"/>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="About"/>
                    </StackPanel>

                    <Border CornerRadius="10" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Accent -->
                            <Border Grid.Column="0" CornerRadius="10,0,0,10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#4C7DFF" Offset="0"/>
                                        <GradientStop Color="#2850B7" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="16,14,16,16">
                                <!-- Meta info as badges -->
                                <WrapPanel Margin="0,0,0,12">
                                    <Border Background="#2F3037" Padding="10,6" CornerRadius="16" Margin="0,0,8,8" BorderBrush="#44464F" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Tag24" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Version: 1.0.0" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#2F3037" Padding="10,6" CornerRadius="16" Margin="0,0,8,8" BorderBrush="#44464F" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="CalendarLtr24" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Build: 2023-10-01" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#2F3037" Padding="10,6" CornerRadius="16" Margin="0,0,8,8" BorderBrush="#44464F" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ShieldCheckmark24" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="License: All rights reserved" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#2F3037" Padding="10,6" CornerRadius="16" Margin="0,0,8,8" BorderBrush="#44464F" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="PeopleCommunity24" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="© 2025 Modrix Team" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>

                                <TextBlock Text="Modrix helps you streamline Minecraft mod and resource pack development with modern tooling and a unified workspace." TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                <StackPanel Orientation="Horizontal">
                                    <ui:Button
                                        Content="Explore Source Code"
                                        Icon="{ui:SymbolIcon Open24}"
                                        Appearance="Primary"
                                        Click="ExploreSourceCode_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>

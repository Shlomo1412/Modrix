<Page x:Class="Modrix.Views.Pages.ItemPickerDemoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Modrix.Views.Controls"
      Title="ItemPicker Demo"
      Background="{DynamicResource ApplicationBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,24,40,40" VerticalAlignment="Top" MaxWidth="800" HorizontalAlignment="Center">
            
            <TextBlock Text="ItemPicker Control Demo" FontSize="28" FontWeight="Bold" 
                      HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <TextBlock Text="This page demonstrates the usage of the new ItemPicker control alongside the existing TexturePicker control." 
                      HorizontalAlignment="Center" FontSize="14" 
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                      TextWrapping="Wrap" Margin="0,0,0,40"/>

            <!-- Comparison Section -->
            <ui:Card Padding="30" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- TexturePicker Column -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="TexturePicker (Original)" FontWeight="SemiBold" FontSize="18" 
                                  HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        
                        <TextBlock Text="- General texture selection" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock Text="- All texture categories (blocks, items, entities, etc.)" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock Text="- Best for texture editing workflows" FontSize="12" Margin="0,0,0,16"/>
                        
                        <controls:TexturePicker x:Name="DemoTexturePicker" 
                                               HorizontalAlignment="Center"
                                               TextureSelected="DemoTexturePicker_TextureSelected"/>
                        
                        <TextBlock x:Name="TexturePickerStatus" Text="No texture selected" 
                                  FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- ItemPicker Column -->
                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <TextBlock Text="ItemPicker (New)" FontWeight="SemiBold" FontSize="18" 
                                  HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        
                        <TextBlock Text="- Focused on items and blocks only" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock Text="- Type filtering (items, blocks, or both)" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock Text="- Optimized for game content selection" FontSize="12" Margin="0,0,0,16"/>
                        
                        <controls:ItemPicker x:Name="DemoItemPicker" 
                                            HorizontalAlignment="Center"
                                            ItemSelected="DemoItemPicker_ItemSelected"/>
                        
                        <TextBlock x:Name="ItemPickerStatus" Text="No item selected" 
                                  FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- ItemPicker Types Demo -->
            <ui:Card Padding="30" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="ItemPicker Type Filtering" FontWeight="SemiBold" FontSize="18" 
                              HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Items Only -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="Items Only" FontWeight="SemiBold" FontSize="14" 
                                      HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <controls:ItemPicker x:Name="ItemsOnlyPicker" 
                                                ItemType="Items"
                                                ItemSelected="ItemsOnlyPicker_ItemSelected"/>
                            <TextBlock x:Name="ItemsOnlyStatus" Text="No item selected" 
                                      FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Blocks Only -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="Blocks Only" FontWeight="SemiBold" FontSize="14" 
                                      HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <controls:ItemPicker x:Name="BlocksOnlyPicker" 
                                                ItemType="Blocks"
                                                ItemSelected="BlocksOnlyPicker_ItemSelected"/>
                            <TextBlock x:Name="BlocksOnlyStatus" Text="No block selected" 
                                      FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Both -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="Both (Default)" FontWeight="SemiBold" FontSize="14" 
                                      HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <controls:ItemPicker x:Name="BothPicker" 
                                                ItemType="Both"
                                                ItemSelected="BothPicker_ItemSelected"/>
                            <TextBlock x:Name="BothStatus" Text="No item/block selected" 
                                      FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Usage Guidelines -->
            <ui:Card Padding="30" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="When to Use Each Control" FontWeight="SemiBold" FontSize="18" 
                              HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Use TexturePicker for:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock Text="- Texture editing workflows" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock Text="- Resource pack development" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock Text="- General texture selection" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock Text="- Entity, GUI, particle textures" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock Text="- When you need all texture categories" FontSize="12" Margin="0,0,0,4"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Use ItemPicker for:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock Text="- Mod element creation (items/blocks)" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock Text="- Recipe ingredient selection" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock Text="- Game content workflows" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock Text="- When you only need items/blocks" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock Text="- Focused content selection" FontSize="12" Margin="0,0,0,4"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Code Examples -->
            <ui:Card Padding="30">
                <StackPanel>
                    <TextBlock Text="Code Examples" FontWeight="SemiBold" FontSize="18" 
                              HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    
                    <TextBlock Text="XAML Usage:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" 
                           CornerRadius="4" Padding="12" Margin="0,0,0,16">
                        <TextBlock FontFamily="Cascadia Code, Consolas, Monaco, monospace" FontSize="11" xml:space="preserve">&lt;!-- Basic usage --&gt;
&lt;controls:ItemPicker ItemSelected="OnItemSelected" /&gt;

&lt;!-- Items only --&gt;
&lt;controls:ItemPicker ItemType="Items" 
                     ProjectData="{Binding CurrentProject}"
                     MinecraftVersion="{Binding MinecraftVersion}" /&gt;

&lt;!-- Blocks only --&gt;
&lt;controls:ItemPicker ItemType="Blocks" 
                     SelectedItemPath="{Binding BlockTexturePath}" /&gt;</TextBlock>
                    </Border>
                    
                    <TextBlock Text="C# Event Handling:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" 
                           CornerRadius="4" Padding="12">
                        <TextBlock FontFamily="Cascadia Code, Consolas, Monaco, monospace" FontSize="11" xml:space="preserve">private void OnItemSelected(object sender, string? itemPath)
{
    if (itemPath != null)
    {
        Console.WriteLine($"Selected: {Path.GetFileName(itemPath)}");
        // Use the selected item texture path
    }
    else
    {
        Console.WriteLine("Selection cleared");
    }
}</TextBlock>
                    </Border>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
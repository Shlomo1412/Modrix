<Page x:Class="Modrix.Views.Pages.ModelViewerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:helix="http://helix-toolkit.org/wpf"
      mc:Ignorable="d"
      Title="ModelViewerPage"
      d:DesignHeight="600"
      d:DesignWidth="900">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                CornerRadius="8" 
                Padding="16,12" 
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <ui:SymbolIcon Grid.Column="0" 
                              Symbol="Cube24" 
                              Width="24" Height="24"
                              Margin="0,0,12,0"/>
                
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding ModelName}" 
                              FontWeight="SemiBold" 
                              FontSize="16"/>
                    <TextBlock Text="{Binding StatusMessage}" 
                              FontSize="12" 
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button Content="Reload"
                              Icon="{ui:SymbolIcon ArrowClockwise24}"
                              Click="ReloadModel_Click"
                              Margin="0,0,8,0"/>
                    <ui:Button Content="Open in Editor"
                              Icon="{ui:SymbolIcon Edit24}"
                              Click="OpenInEditor_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 3D Viewer -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource ControlFillColorDefaultBrush}" 
                    CornerRadius="8" 
                    Margin="0,0,6,0">
                <Grid>
                    <!-- Loading Overlay -->
                    <Border Background="Black" 
                            Opacity="0.7" 
                            CornerRadius="8"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48"/>
                            <TextBlock Text="Loading model..." 
                                      Foreground="White" 
                                      Margin="0,12,0,0"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 3D Viewport -->
                    <helix:HelixViewport3D x:Name="Viewport3D" 
                                          Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                          ShowViewCube="True"
                                          ShowCoordinateSystem="True">
                        
                        <!-- Lighting -->
                        <helix:DefaultLights/>
                        
                        <!-- Model Container -->
                        <ModelVisual3D x:Name="ModelContainer">
                            <ModelVisual3D.Content>
                                <Binding Path="Model3D"/>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>
                        
                        <!-- Camera -->
                        <helix:HelixViewport3D.Camera>
                            <PerspectiveCamera Position="1.5,1.5,1.5" LookDirection="-1,-1,-1" UpDirection="0,1,0" FieldOfView="45"/>
                        </helix:HelixViewport3D.Camera>
                    </helix:HelixViewport3D>
                    
                    <!-- Viewer Controls -->
                    <StackPanel Orientation="Horizontal" 
                               HorizontalAlignment="Right" 
                               VerticalAlignment="Top" 
                               Margin="12">
						<ui:Button Icon="{ui:SymbolIcon CameraSwitch20}"
                                  ToolTip="Reset View"
                                  Click="ResetView_Click"
                                  Margin="0,0,4,0"/>
						<ui:Button Icon="{ui:SymbolIcon Camera24}"
                                  ToolTip="Export Screenshot"
                                  Click="ExportScreenshot_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Splitter -->
            <GridSplitter Grid.Column="1" 
                         Width="6" 
                         HorizontalAlignment="Center" 
                         VerticalAlignment="Stretch"
                         Background="Transparent"/>
            
            <!-- Properties Panel -->
            <Border Grid.Column="2" 
                    Background="{DynamicResource ControlFillColorDefaultBrush}" 
                    CornerRadius="8" 
                    Padding="12"
                    Margin="6,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Model Information -->
                        <TextBlock Text="Model Information" 
                                  FontWeight="SemiBold" 
                                  FontSize="14" 
                                  Margin="0,0,0,8"/>
                        
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                               CornerRadius="6" 
                               Padding="8" 
                               Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="File:" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="{Binding ModelName}" 
                                          FontSize="11" 
                                          TextWrapping="Wrap"
                                          Margin="0,2,0,8"/>
                                
                                <TextBlock Text="Path:" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="{Binding ModelPath}" 
                                          FontSize="11" 
                                          TextWrapping="Wrap"
                                          Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Texture References -->
                        <TextBlock Text="Texture References" 
                                  FontWeight="SemiBold" 
                                  FontSize="14" 
                                  Margin="0,0,0,8"/>
                        
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                               CornerRadius="6" 
                               Padding="8" 
                               Margin="0,0,0,16">
                            <ItemsControl ItemsSource="{Binding TextureReferences}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" 
                                               CornerRadius="4" 
                                               Padding="6" 
                                               Margin="0,0,0,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Key}" 
                                                          FontWeight="SemiBold" 
                                                          FontSize="11"/>
                                                <TextBlock Text="{Binding Value}" 
                                                          FontSize="10" 
                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                          TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        
                        <!-- Viewer Settings -->
                        <TextBlock Text="Viewer Settings" 
                                  FontWeight="SemiBold" 
                                  FontSize="14" 
                                  Margin="0,0,0,8"/>
                        
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                               CornerRadius="6" 
                               Padding="8" 
                               Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox Content="Show Wireframe" 
                                         x:Name="WireframeCheckBox"
                                         Checked="WireframeToggle_Changed"
                                         Unchecked="WireframeToggle_Changed"
                                         Margin="0,0,0,8"/>
                                
                                <CheckBox Content="Show Coordinate System" 
                                         x:Name="CoordinateSystemCheckBox"
                                         IsChecked="True"
                                         Checked="CoordinateSystemToggle_Changed"
                                         Unchecked="CoordinateSystemToggle_Changed"
                                         Margin="0,0,0,8"/>
                                
                                <CheckBox Content="Show View Cube" 
                                         x:Name="ViewCubeCheckBox"
                                         IsChecked="True"
                                         Checked="ViewCubeToggle_Changed"
                                         Unchecked="ViewCubeToggle_Changed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        
        <!-- JSON Viewer (Collapsible) -->
        <Expander Grid.Row="2" 
                 Header="Model JSON" 
                 Margin="0,12,0,0"
                 Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                   CornerRadius="6" 
                   Padding="12"
                   Margin="8">
                <TextBox Text="{Binding ModelJson}"
                        IsReadOnly="True"
                        FontFamily="Consolas"
                        FontSize="12"
                        MinHeight="200"
                        MaxHeight="300"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        Background="Transparent"
                        BorderThickness="0"/>
            </Border>
        </Expander>
    </Grid>
</Page>
<Page
    x:Class="Modrix.Views.Pages.ResourcePack.TranslationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Modrix.Views.Pages.ResourcePack"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Modrix.Views.Controls"
    Title="Minecraft Translations"
    d:DataContext="{d:DesignInstance Type=local:TranslationsPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="LightGray" 
                CornerRadius="0,0,18,18" Padding="0,0,0,18" Margin="0,0,0,18">
            <Grid Margin="32,24,32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="22" FontWeight="Bold" Text="Minecraft Translations" />
                        <controls:WikiTooltip 
                            WikiId="minecraft-translations"
                            Title="Minecraft Translations"
                            Category="Textures"
                            Keywords="minecraft,translations,language,localization,lang,json"
                            Description="Browse and edit Minecraft's language files to create custom translations. Each language file contains key-value pairs that define text shown in the game interface, items, blocks, and more."
                            Margin="8,5,0,0"
                            VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Margin="0,2,0,0" FontSize="13" 
                               Foreground="Gray" 
                               Text="Browse and create overrides from Minecraft language files" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <ui:Button Appearance="Primary" Content="Create Override" 
                               Icon="{ui:SymbolIcon Add24}" Height="40" 
                               ToolTip="Create New Translation Override" 
                               Click="CreateOverride_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="32,0,32,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Languages Sidebar -->
            <Border Grid.Column="0" Background="White" 
                    CornerRadius="12" Padding="16" Margin="0,0,18,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Languages" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <ListBox x:Name="LanguagesList" Grid.Row="1" 
                             Background="Transparent" BorderThickness="0"
                             SelectionChanged="LanguagesList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon Grid.Column="0" Symbol="LocalLanguage24" 
                                                  Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Code}" FontSize="10" 
                                                  Foreground="Gray"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding KeyCount}" 
                                              FontSize="10" 
                                              Foreground="Gray"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Border Grid.Column="1" Background="White" 
                    CornerRadius="12" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search and Controls -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBox x:Name="SearchBox" 
                                   PlaceholderText="Search translation keys..."
                                   Icon="{ui:SymbolIcon Search24}"
                                   TextChanged="SearchBox_TextChanged"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                            <ui:Button Content="Export Language" 
                                      Icon="{ui:SymbolIcon ArrowExportLtr24}"
                                      Click="ExportLanguage_Click"
                                      Margin="0,0,8,0"/>
                            <ui:Button Content="Refresh" 
                                      Icon="{ui:SymbolIcon ArrowClockwise24}"
                                      Click="RefreshTranslations_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Translations Display -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!-- Main Content -->
                            <ListView x:Name="TranslationsGrid" 
                                     Background="Transparent" 
                                     BorderThickness="0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Key" Width="250" 
                                                       DisplayMemberBinding="{Binding Key}"/>
                                        <GridViewColumn Header="Original Value" Width="300" 
                                                       DisplayMemberBinding="{Binding OriginalValue}"/>
                                        <GridViewColumn Header="Language" Width="100" 
                                                       DisplayMemberBinding="{Binding LanguageCode}"/>
                                        <GridViewColumn Header="Actions" Width="100">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Override" 
                                                           Tag="{Binding}" 
                                                           Click="CreateKeyOverride_Click" 
                                                           Padding="8,4"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <!-- Empty State -->
                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" Visibility="Visible">
                                <ui:SymbolIcon Symbol="LocalLanguage28" FontSize="48" 
                                              Foreground="Gray"/>
                                <TextBlock Text="No translations found" FontSize="16" FontWeight="SemiBold" 
                                          Margin="0,8,0,4" HorizontalAlignment="Center"/>
                                <TextBlock Text="Select a language file to view its translations" 
                                          FontSize="14" Foreground="Gray" 
                                          HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
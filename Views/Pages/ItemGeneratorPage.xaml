<Page x:Class="Modrix.Views.Pages.ItemGeneratorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Modrix.Views.Controls"
      Title="ItemGeneratorPage"
      Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sticky Header -->
        <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="3,3,18,18" Padding="0,0,0,18" Margin="0,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="32,10,0,0" VerticalAlignment="Center">
                    <ui:Image Source="pack://application:,,,/Resources/Icons/ItemIcon.png" Width="36" Height="36" Margin="0,0,12,0"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Create New Item" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <controls:WikiTooltip 
                                WikiId="item-generation"
                                Title="Item Generation"
                                Category="Projects"
                                Keywords="item,generation,custom,minecraft,properties"
                                Description="Items are custom objects that players can hold, use, and interact with in Minecraft. When you create an item, Modrix generates all necessary files including Java classes, JSON models, textures, and recipe files. You can customize properties like stack size, food values, and special behaviors."
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Define your custom item for your mod" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="1" Margin="0,10,32,0">
                    <ui:Button Content="Cancel" Width="100" Margin="0,0,8,0" Click="Cancel_Click"/>
                    <ui:Button Content="Create" Appearance="Primary" Width="120" Click="Create_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,24,40,40" VerticalAlignment="Top" MaxWidth="520" HorizontalAlignment="Center">
                <!-- Item Name -->
                <ui:Card Padding="24" Margin="0,0,0,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Item Name" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                            <controls:WikiTooltip 
                                WikiId="item-naming"
                                Title="Item Naming Rules"
                                Category="General"
                                Keywords="naming,item,registry,conventions,rules"
                                Description="Item names must follow Minecraft naming conventions: lowercase letters, numbers, and underscores only. No spaces or special characters. The name becomes the item's registry ID and affects file names for textures and models."
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                        <ui:TextBox x:Name="NameTextBox" Width="300" Height="32" Margin="0,0,0,0" Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Enter item name..."/>
                    </StackPanel>
                </ui:Card>

                <!-- Texture -->
                <ui:Card Padding="24" Margin="0,0,0,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Texture" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                            <controls:WikiTooltip 
                                WikiId="item-textures"
                                Title="Item Textures"
                                Category="Textures"
                                Keywords="item,texture,16x16,png,pixels"
                                Description="Item textures are 16x16 pixel PNG images that define how your item looks in inventories and when held. You can create custom textures or use existing ones. The texture file must be placed in the textures/item folder of your mod."
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <controls:TexturePicker x:Name="TexturePicker" 
                                                   ProjectData="{Binding CurrentProject}"
                                                   MinecraftVersion="{Binding MinecraftVersion}"
                                                   SelectedTexturePath="{Binding TexturePath, Mode=TwoWay}"
                                                   TextureSelected="TexturePicker_TextureSelected"/>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Select a texture for your item" 
                                          FontSize="12" Margin="0,0,0,4"/>
                                <TextBlock Text="Choose from your project textures" 
                                          FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="Or pick from Minecraft assets" 
                                          FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- Properties -->
                <ui:Card Padding="24" Margin="0,0,0,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Properties" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                            <controls:WikiTooltip 
                                WikiId="item-properties"
                                Title="Item Properties"
                                Category="Projects"
                                Keywords="properties,stack,size,enchantment,glint,food"
                                Description="Item properties control how your item behaves in game. Stack size determines how many can fit in one inventory slot. Enchanted glint adds a magical shimmer effect. Food items restore hunger and can have additional effects."
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Stack Size -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Max Stack Size:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Width="100" HorizontalAlignment="Left" SelectedValue="{Binding MaxStackSize}" Margin="0,0,0,8">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="16"/>
                                <ComboBoxItem Content="64" IsSelected="True"/>
                            </ComboBox>
                            <!-- Glint -->
                            <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="Has Enchanted Glint" IsChecked="{Binding HasGlint}" Margin="0,0,0,8"/>
                            <!-- Food -->
                            <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Is Food Item" IsChecked="{Binding IsFood}" Margin="0,0,0,8"
                                      Checked="IsFood_Checked" Unchecked="IsFood_Unchecked"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Food Properties (conditionally visible) -->
                <ui:Card Padding="24" Margin="0,0,0,18" x:Name="FoodPropertiesPanel" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Food Properties" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                            <controls:WikiTooltip 
                                WikiId="food-properties"
                                Title="Food Properties"
                                Category="Projects"
                                Keywords="food,hunger,saturation,nutrition,minecraft"
                                Description="Food items restore hunger points (visible hunger bar) and saturation (hidden nutrition). Hunger points determine how much the hunger bar fills, while saturation affects how long before you get hungry again. Most vanilla foods have 1-8 hunger points."
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Food Value (Hunger Points) -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Hunger Points:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <ui:NumberBox Grid.Row="0" Grid.Column="1" MinWidth="100" HorizontalAlignment="Left" Value="{Binding FoodValue}" Margin="0,0,0,8" Minimum="0" Maximum="20"/>
                            <!-- Saturation -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Saturation:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <ui:NumberBox Grid.Row="1" Grid.Column="1" MinWidth="100" HorizontalAlignment="Left" Value="{Binding SaturationValue}" Margin="0,0,0,8" Minimum="0" Maximum="20"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- NavigationView at bottom -->
        <ui:NavigationView PaneDisplayMode="Bottom" VerticalAlignment="Bottom" Height="60" Grid.Row="2">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Home" Icon="Home24"/>
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
    </Grid>
</Page>
<UserControl x:Class="Modrix.Views.Controls.ItemPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    
    <ui:Card Padding="4" Width="80" Height="80" Cursor="Hand" 
             Background="{DynamicResource ControlFillColorSecondaryBrush}"
             BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
             MouseLeftButtonDown="ItemPickerCard_Click">
        <Grid>
            <!-- Default state - no item selected -->
            <StackPanel x:Name="DefaultContent" Visibility="Visible" 
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Box24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                              FontSize="24" Margin="0,0,0,4"/>
                <TextBlock Text="Select" FontSize="10" 
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Item selected state -->
            <Image x:Name="ItemImage" Visibility="Collapsed" 
                   Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            
            <!-- Clear button overlay -->
            <ui:Button x:Name="ClearButton" Visibility="Collapsed"
                      Width="20" Height="20" Padding="0"
                      VerticalAlignment="Top" HorizontalAlignment="Right"
                      Margin="0,-2,-2,0"
                      Appearance="Secondary"
                      Click="ClearButton_Click">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Dismiss12" FontSize="10"/>
                </ui:Button.Icon>
            </ui:Button>
        </Grid>
    </ui:Card>
</UserControl>
<UserControl x:Class="Modrix.Views.Controls.WikiTooltip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Width="Auto"
             Height="Auto"
             x:Name="WikiTooltipControl">

    <UserControl.Resources>
        <!-- Clean, solid-color styled tooltip (no broken dynamic resources) -->
        <Style x:Key="WikiTooltipStyle" TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="#1E1F26"/>
            <Setter Property="BorderBrush" Value="#2C2F36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MaxWidth" Value="460"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Accent stripe -->
                                <Border Grid.Column="0"
                                        CornerRadius="10,0,0,10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#4C7DFF" Offset="0"/>
                                            <GradientStop Color="#2850B7" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Content -->
                                <StackPanel Grid.Column="1" Margin="14,12,16,14">
                                    <!-- Title -->
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               FontSize="15"
                                               Margin="0,0,0,6"/>

                                    <!-- Description -->
                                    <TextBlock Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               LineHeight="20"
                                               Foreground="#DDFFFFFF"/>

                                    <!-- Category pill -->
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Border CornerRadius="6"
                                                Background="#2D4C7F"
                                                Padding="8,4"
                                                Opacity="0.95">
                                            <TextBlock Text="{Binding Category}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ui:Button Width="20"
               Height="20"
               Padding="0"
               Appearance="Transparent"
               Foreground="#B0B6C3"
               ToolTipService.InitialShowDelay="300"
               ToolTipService.ShowDuration="10000"
               ToolTipService.BetweenShowDelay="100"
               Tag="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
        <ui:Button.Icon>
            <ui:SymbolIcon Symbol="QuestionCircle24" />
        </ui:Button.Icon>
        <ui:Button.ToolTip>
            <ToolTip Style="{StaticResource WikiTooltipStyle}">
                <ToolTip.DataContext>
                    <Binding RelativeSource="{RelativeSource Self}" Path="PlacementTarget.Tag" />
                </ToolTip.DataContext>
            </ToolTip>
        </ui:Button.ToolTip>
    </ui:Button>
</UserControl>

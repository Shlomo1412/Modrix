<ui:FluentWindow x:Class="Modrix.Views.Windows.TextureSelectionDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                Title="Select Texture" 
                Width="800" Height="600"
                WindowStartupLocation="CenterOwner"
                ResizeMode="CanResize">

    <ui:FluentWindow.Resources>
        <!-- Texture item template -->
        <DataTemplate x:Key="TextureItemTemplate">
            <ui:Card Margin="4" Padding="8" Width="120" Height="140" Cursor="Hand"
                     Tag="{Binding}" MouseLeftButtonDown="TextureItem_Click"
                     Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <StackPanel>
                    <!-- Texture preview -->
                    <Border Width="80" Height="80" Margin="0,0,0,8"
                           Background="{DynamicResource ControlFillColorDefaultBrush}"
                           BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                           BorderThickness="1" CornerRadius="4">
                        <Image Source="{Binding PreviewImage}" 
                               Stretch="UniformToFill" 
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                    
                    <!-- Texture name -->
                    <TextBlock Text="{Binding Name}" 
                               FontSize="11" FontWeight="Medium"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Name}"/>
                    
                    <!-- Category -->
                    <TextBlock Text="{Binding Category}" 
                               FontSize="9" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </ui:Card>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}" 
                Padding="24,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Select Texture" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Choose a texture from your project or Minecraft assets" 
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Search box -->
                <ui:TextBox x:Name="SearchBox" Grid.Column="1"
                           Width="200" PlaceholderText="Search textures..."
                           TextChanged="SearchBox_TextChanged"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar with tabs and categories -->
            <Border Grid.Column="0" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    Margin="0,0,16,0" Padding="16" CornerRadius="8">
                <StackPanel>
                    <!-- Tab buttons -->
                    <ui:Button x:Name="ProjectTabButton" Content="Project Textures" 
                              Width="160" Margin="0,0,0,8" 
                              Appearance="Secondary" Click="ProjectTab_Click"/>
                    <ui:Button x:Name="MinecraftTabButton" Content="Minecraft Assets" 
                              Width="160" Margin="0,0,0,16"
                              Appearance="Secondary" Click="MinecraftTab_Click"/>
                    
                    <!-- Categories for current tab -->
                    <TextBlock Text="Categories" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ListBox x:Name="CategoriesList" 
                             Background="Transparent" 
                             BorderThickness="0"
                             SelectionChanged="CategoriesList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="14" 
                                                  Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="12"/>
                                    <TextBlock Text="{Binding Count, StringFormat=({0})}" 
                                              FontSize="10" Margin="4,0,0,0"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <!-- Extract assets button (for Minecraft tab) -->
                    <ui:Button x:Name="ExtractAssetsButton" Content="Extract Assets" 
                              Width="160" Margin="0,16,0,0" 
                              Visibility="Collapsed"
                              Appearance="Primary" Click="ExtractAssets_Click"/>
                </StackPanel>
            </Border>

            <!-- Textures grid -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="TexturesGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <StaticResource ResourceKey="TextureItemTemplate"/>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" Grid.Column="1" 
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed">
                <ui:SymbolIcon Symbol="Image24" FontSize="48" 
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                              Margin="0,0,0,16"/>
                <TextBlock x:Name="EmptyStateText" Text="No textures found" 
                          FontSize="16" FontWeight="SemiBold" 
                          HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock x:Name="EmptyStateSubtext" Text="Try selecting a different category or search term" 
                          FontSize="12" 
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Loading state -->
            <StackPanel x:Name="LoadingState" Grid.Column="1"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,16"/>
                <TextBlock x:Name="LoadingText" Text="Loading textures..." 
                          FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}" 
                Padding="24,16" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel" Width="80" Margin="0,0,8,0" 
                          Click="Cancel_Click"/>
                <ui:Button Content="Select" Width="80" 
                          Appearance="Primary" Click="Select_Click"
                          IsEnabled="False" x:Name="SelectButton"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
<ui:FluentWindow
    x:Class="Modrix.Views.Windows.ImportProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Import Project"
    Height="550"
    Width="520"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    ExtendsContentIntoTitleBar="True"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
  <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>

      <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18" VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="ArrowDownload24" Width="40" Height="40" Margin="0,0,12,0"/>
     <StackPanel>
                <TextBlock Text="Import Modrix Project" FontSize="22" FontWeight="Bold"/>
       <TextBlock Text="Import a shared .modrix project file" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
          </StackPanel>
        </StackPanel>

        <!-- Content -->
        <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="18" Margin="0,0,0,18">
         <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel>
     <TextBlock Text="Project Information" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,16"/>
             
     <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
         <ColumnDefinition Width="Auto"/>
       <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
  <RowDefinition Height="Auto"/>
 <RowDefinition Height="Auto"/>
           <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
       
           <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,16,8"/>
           <TextBlock x:Name="TxtProjectName" Grid.Row="0" Grid.Column="1" Text="-" FontWeight="SemiBold" Margin="0,0,0,8"/>
             
   <TextBlock Grid.Row="1" Grid.Column="0" Text="Mod ID:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,16,8"/>
        <TextBlock x:Name="TxtModId" Grid.Row="1" Grid.Column="1" Text="-" FontWeight="SemiBold" Margin="0,0,0,8"/>
          
   <TextBlock Grid.Row="2" Grid.Column="0" Text="Mod Type:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,16,8"/>
     <TextBlock x:Name="TxtModType" Grid.Row="2" Grid.Column="1" Text="-" FontWeight="SemiBold" Margin="0,0,0,8"/>
  
              <TextBlock Grid.Row="3" Grid.Column="0" Text="Minecraft:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,16,8"/>
        <TextBlock x:Name="TxtMinecraftVersion" Grid.Row="3" Grid.Column="1" Text="-" FontWeight="SemiBold" Margin="0,0,0,8"/>
  
 <TextBlock Grid.Row="4" Grid.Column="0" Text="Author(s):" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,16,8"/>
         <TextBlock x:Name="TxtAuthors" Grid.Row="4" Grid.Column="1" Text="-" FontWeight="SemiBold" Margin="0,0,0,8"/>
     
           <TextBlock Grid.Row="5" Grid.Column="0" Text="Created:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,16,8"/>
 <TextBlock x:Name="TxtCreatedDate" Grid.Row="5" Grid.Column="1" Text="-" FontWeight="SemiBold" Margin="0,0,0,8"/>
                
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Modrix Version:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,16,8"/>
         <TextBlock x:Name="TxtModrixVersion" Grid.Row="6" Grid.Column="1" Text="-" FontWeight="SemiBold" Margin="0,0,0,8"/>
       </Grid>

         <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,16"/>

     <TextBlock Text="Description" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
   <TextBlock x:Name="TxtDescription" Text="No description provided." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"/>

 <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,16"/>

            <TextBlock Text="Contents" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
      <Grid Margin="0,0,0,8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
         <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
           <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
  
       <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,4">
     <ui:SymbolIcon Symbol="Cube16" Margin="0,0,8,0"/>
      <TextBlock x:Name="TxtModElementsCount" Text="0 mod elements"/>
   </StackPanel>
      <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
              <ui:SymbolIcon Symbol="Image16" Margin="0,0,8,0"/>
    <TextBlock x:Name="TxtResourcesCount" Text="0 resources"/>
              </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,4">
          <ui:SymbolIcon Symbol="Code16" Margin="0,0,8,0"/>
      <TextBlock x:Name="TxtCodeFilesCount" Text="0 code files"/>
     </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
            <ui:SymbolIcon Symbol="LocalLanguage16" Margin="0,0,8,0"/>
    <TextBlock x:Name="TxtLanguagesCount" Text="0 languages"/>
        </StackPanel>
       </Grid>
         </StackPanel>
    </ScrollViewer>
        </Border>

        <!-- Progress -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,12">
   <TextBlock x:Name="TxtProgress" Text="Importing project..." Margin="0,0,0,8"/>
     <ProgressBar x:Name="ProgressBar" Height="4" IsIndeterminate="False" Value="0"/>
        </StackPanel>

        <!-- Footer -->
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button x:Name="BtnImport"
      Content="Import Project"
                Appearance="Primary"
         Width="140"
      Height="36"
        Margin="0,0,8,0"
     Icon="{ui:SymbolIcon ArrowDownload24}"
 Click="BtnImport_Click"/>
   <ui:Button x:Name="BtnCancel"
           Content="Cancel"
           Width="100"
 Height="36"
             Appearance="Secondary"
    Icon="{ui:SymbolIcon Dismiss24}"
              Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>

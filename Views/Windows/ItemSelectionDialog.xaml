<ui:FluentWindow x:Class="Modrix.Views.Windows.ItemSelectionDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                Title="Select Item" 
                Width="900" Height="600"
                WindowStartupLocation="CenterOwner"
                ShowInTaskbar="False">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,20,20,10">
            <TextBlock Text="Select Item or Block" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
            
            <!-- Tab Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <ui:Button x:Name="ProjectTabButton" Content="Project Items" 
                          Appearance="Primary" Margin="0,0,8,0" 
                          Click="ProjectTab_Click"/>
                <ui:Button x:Name="MinecraftTabButton" Content="Minecraft Assets" 
                          Appearance="Secondary" Margin="0,0,8,0" 
                          Click="MinecraftTab_Click"/>
                <ui:Button x:Name="ExtractAssetsButton" Content="Extract Assets" 
                          Appearance="Secondary" Visibility="Collapsed"
                          Click="ExtractAssets_Click"/>
            </StackPanel>

            <!-- Search -->
            <ui:TextBox x:Name="SearchBox" PlaceholderText="Search items..." 
                       Width="300" HorizontalAlignment="Left"
                       TextChanged="SearchBox_TextChanged"/>
        </StackPanel>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="20,0,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Categories -->
            <Border Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}" 
                   CornerRadius="8" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="Categories" FontWeight="Bold" Margin="12,12,12,8"/>
                    
                    <ListBox x:Name="CategoriesList" Grid.Row="1" 
                            Background="Transparent" BorderThickness="0"
                            SelectionChanged="CategoriesList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Count, StringFormat='({0})'}" 
                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                             Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Items Grid -->
            <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}" 
                   CornerRadius="8">
                <Grid>
                    <!-- Loading State -->
                    <StackPanel x:Name="LoadingState" HorizontalAlignment="Center" 
                               VerticalAlignment="Center" Visibility="Collapsed">
                        <ui:ProgressRing Width="48" Height="48" Margin="0,0,0,16"/>
                        <TextBlock x:Name="LoadingText" Text="Loading..." 
                                  HorizontalAlignment="Center" FontSize="16"/>
                    </StackPanel>

                    <!-- Empty State -->
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" 
                               VerticalAlignment="Center" Visibility="Collapsed">
                        <ui:SymbolIcon Symbol="Box24" FontSize="48" 
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Margin="0,0,0,16"/>
                        <TextBlock x:Name="EmptyStateText" Text="No items found" 
                                  HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="EmptyStateSubtext" Text="Try adjusting your search or category filter" 
                                  HorizontalAlignment="Center" FontSize="14" 
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Items -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <ItemsControl x:Name="ItemsGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" 
                                           Margin="4" Padding="8" 
                                           CornerRadius="6"
                                           Cursor="Hand"
                                           Tag="{Binding}"
                                           MouseLeftButtonDown="ItemCard_Click"
                                           ToolTip="{Binding Name}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Width="80">
                                            <Border Width="64" Height="64" 
                                                   Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                                   CornerRadius="4" Margin="0,0,0,4">
                                                <Image Source="{Binding PreviewImage}" 
                                                      Stretch="Uniform"
                                                      RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" 
                                                      FontSize="11" 
                                                      TextAlignment="Center"
                                                      TextWrapping="Wrap"
                                                      MaxHeight="32"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                   HorizontalAlignment="Right" Margin="20,10,20,20">
            <ui:Button Content="Cancel" Appearance="Secondary" 
                      Margin="0,0,8,0" Click="Cancel_Click"/>
            <ui:Button x:Name="SelectButton" Content="Select" 
                      Appearance="Primary" IsEnabled="False"
                      Click="Select_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
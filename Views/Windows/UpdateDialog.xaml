<ui:FluentWindow
    x:Class="Modrix.Views.Windows.UpdateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:Modrix.Helpers"
    Title="Update Available"
    Width="520"
    Height="500"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    mc:Ignorable="d">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </ui:FluentWindow.Resources>

    <Grid>
        <ui:TitleBar
            x:Name="TitleBar"
            Title="Update Available"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/ModrixIcon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,48,24,24">
            <StackPanel>
                <!-- Header -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Width="60" Height="60" CornerRadius="12" 
                                Background="{DynamicResource AccentFillColorSecondaryBrush}" 
                                Margin="0,0,16,0">
                            <ui:SymbolIcon Symbol="ArrowDownload24" 
                                         Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                         FontSize="28" 
                                         HorizontalAlignment="Center" 
                                         VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Update Available" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="UpdateVersionText" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Update Information -->
                <ui:Card Margin="0,0,0,16" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Update Information" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Current Version:" FontWeight="Medium" MinWidth="120"/>
                            <TextBlock x:Name="CurrentVersionText" Grid.Column="1" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="New Version:" FontWeight="Medium" MinWidth="120"/>
                            <TextBlock x:Name="NewVersionText" Grid.Column="1" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="File Size:" FontWeight="Medium" MinWidth="120"/>
                            <TextBlock x:Name="FileSizeText" Grid.Column="1" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Release Date:" FontWeight="Medium" MinWidth="120"/>
                            <TextBlock x:Name="ReleaseDateText" Grid.Column="1" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Release Notes -->
                <ui:Card Margin="0,0,0,16" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Release Notes" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                                CornerRadius="6" 
                                Padding="12" 
                                MaxHeight="120">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="ReleaseNotesText" 
                                         TextWrapping="Wrap" 
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!-- Progress Section -->
                <ui:Card x:Name="ProgressCard" 
                         Visibility="Collapsed" 
                         Margin="0,0,0,16" 
                         Padding="20">
                    <StackPanel>
                        <TextBlock Text="Installing Update..." FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ProgressStatusText" 
                                 Text="Preparing..." 
                                 Margin="0,0,0,8"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ProgressBar x:Name="ProgressBar" 
                                   Height="8" 
                                   Value="0" 
                                   Minimum="0" 
                                   Maximum="100"/>
                    </StackPanel>
                </ui:Card>

                <!-- Action Buttons -->
                <StackPanel x:Name="ActionButtonsPanel" 
                          Orientation="Horizontal" 
                          HorizontalAlignment="Right">
                    <ui:Button x:Name="RemindLaterButton"
                             Content="Remind Me Later"
                             Appearance="Secondary"
                             Margin="0,0,12,0"
                             Padding="16,8"
                             Click="RemindLaterButton_Click"/>
                    <ui:Button x:Name="SkipVersionButton"
                             Content="Skip This Version"
                             Appearance="Secondary"
                             Margin="0,0,12,0"
                             Padding="16,8"
                             Click="SkipVersionButton_Click"/>
                    <ui:Button x:Name="InstallUpdateButton"
                             Content="Install Update"
                             Appearance="Primary"
                             Icon="{ui:SymbolIcon ArrowDownload24}"
                             Padding="16,8"
                             Click="InstallUpdateButton_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
<ui:FluentWindow
    x:Class="Modrix.Views.Windows.NewProject"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Modrix.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Modrix.Views.Controls"
    Title="New Minecraft Mod Project"
    Width="580"
    Height="620"
    ShowInTaskbar="False"
    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
    ScrollViewer.VerticalScrollBarVisibility="Disabled"
    d:DesignWidth="580"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar
            Title="New Project"
            Grid.Row="0"
            Icon="{ui:SymbolIcon Add24}">
        </ui:TitleBar>

        <!-- Header -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="42,16,42,8" VerticalAlignment="Center">
            <ui:Image Source="pack://application:,,,/Resources/Icons/WorkspaceIcon.png" Width="40" Height="40" Margin="0,0,12,0"/>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Create New Mod Project" FontSize="22" FontWeight="Bold"/>
                    <controls:WikiTooltip 
                        WikiId="new-project-setup"
                        Title="Project Setup"
                        Category="Projects"
                        Keywords="new,project,setup,configuration,mod,creation"
                        Description="Creating a new mod project sets up all the necessary files and folder structure for Minecraft modding. Choose your mod loader (Fabric/Forge), target Minecraft version, and provide basic information. Modrix will generate all template files automatically."
                        Margin="8,5,0,0"
                        VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Configure your Minecraft mod project settings" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Content Area -->
        <Border Grid.Row="2" 
                Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                CornerRadius="12" 
                Margin="42,8,42,16">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,20,24,20">
                        <!-- Project Name -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock 
                                Margin="0,0,0,4"
                                FontWeight="SemiBold" 
                                Text="Project Name" />
                            <controls:WikiTooltip 
                                WikiId="project-name"
                                Title="Project Name"
                                Category="Projects"
                                Keywords="project,name,display,title"
                                Description="The project name is the display title of your mod that users will see. This appears in mod menus and documentation. It can contain spaces and special characters, unlike the Mod ID."
                                Margin="8,0,0,4"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                        <ui:TextBox
                            x:Name="ProjectNameBox"
                            Margin="0,0,0,16"
                            PlaceholderText="Project Name"
                            Icon="{ui:SymbolIcon Edit24}"
                            ToolTip="The display name of your mod"/>

                        <!-- Mod/Pack ID -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock 
                                Margin="0,0,0,4"
                                FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem.Content, ElementName=ModTypeComboBox}" Value="Resource Pack">
                                                <Setter Property="Text" Value="Pack ID" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedItem.Content, ElementName=ModTypeComboBox}" Value="Forge Mod">
                                                <Setter Property="Text" Value="Mod ID" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedItem.Content, ElementName=ModTypeComboBox}" Value="Fabric Mod">
                                                <Setter Property="Text" Value="Mod ID" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <controls:WikiTooltip 
                                WikiId="mod-id-rules"
                                Title="Mod ID Rules"
                                Category="General"
                                Keywords="mod,id,registry,namespace,naming"
                                Description="The Mod ID is a unique identifier for your mod in Minecraft. It must be lowercase, contain only letters, numbers, and underscores (no spaces or special characters). This becomes your mod's namespace for all items, blocks, and assets (e.g., mymod:stone_block)."
                                Margin="8,0,0,4"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                        <ui:TextBox
                            x:Name="ModIdBox"
                            Margin="0,0,0,16"
                            PlaceholderText="lowercase_id"
                            Icon="{ui:SymbolIcon Document24}"
                            ToolTip="Unique identifier (lowercase, no spaces)"/>

                        <!-- Project Type -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock 
                                Margin="0,0,0,4"
                                FontWeight="SemiBold" 
                                Text="Project Type" />
                            <controls:WikiTooltip 
                                WikiId="project-types"
                                Title="Mod Loaders"
                                Category="General"
                                Keywords="fabric,forge,resource pack,modloader,performance"
                                Description="Fabric is lightweight and fast, ideal for performance mods and quick updates. Forge has more APIs and features, better for complex content mods but slower to update. Resource packs only change textures and models without code."
                                Margin="8,0,0,4"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                        <ui:CardControl
                            ToolTip="Choose your project type"
                            Margin="0,0,0,16">
                            <ui:CardControl.Content>
                                <ComboBox
                                    x:Name="ModTypeComboBox"
                                    Width="Auto"
                                    MinWidth="390"
                                    SelectionChanged="ModTypeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Forge Mod" />
                                    <ComboBoxItem Content="Fabric Mod" />
                                    <ComboBoxItem Content="Resource Pack" />
                                </ComboBox>
                            </ui:CardControl.Content>
                        </ui:CardControl>

                        <!-- Mod-specific fields -->
                        <StackPanel x:Name="ModSpecificFields">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem.Content, ElementName=ModTypeComboBox}" Value="Resource Pack">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Package -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock 
                                    Margin="0,0,0,4"
                                    FontWeight="SemiBold" 
                                    Text="Package" />
                                <controls:WikiTooltip 
                                    WikiId="java-package-naming"
                                    Title="Java Package Naming"
                                    Category="General"
                                    Keywords="java,package,naming,organization,structure"
                                    Description="Java packages organize your code and prevent naming conflicts. Use reverse domain notation (com.yourname.modname) if you have a website, or net.yourname.modname otherwise. Use lowercase letters and dots only."
                                    Margin="8,0,0,4"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                            <ui:TextBox
                                x:Name="PackageBox"
                                Margin="0,0,0,16"
                                PlaceholderText="net.modrix.mymod"
                                Icon="{ui:SymbolIcon Box24}"
                                ToolTip="Java package name for your mod"/>

                            <!-- Minecraft Version -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock 
                                    Margin="0,0,0,4"
                                    FontWeight="SemiBold" 
                                    Text="Minecraft Version" />
                                <controls:WikiTooltip 
                                    WikiId="minecraft-version-selection"
                                    Title="Choosing Minecraft Version"
                                    Category="General"
                                    Keywords="minecraft,version,compatibility,java,requirements"
                                    Description="Choose based on your target audience and required Java version. 1.20.x requires Java 17, 1.21.x requires Java 21. Newer versions have more features but smaller player bases. Consider mod loader stability for your chosen version."
                                    Margin="8,0,0,4"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                            <ui:CardControl
                                ToolTip="Select the Minecraft version for your mod"
                                Margin="0,0,0,16">
                                <ui:CardControl.Content>
                                    <ComboBox
                                        x:Name="MinecraftVersionComboBox"
                                        Width="Auto"
                                        MinWidth="390">
                                        <ComboBoxItem Content="1.21.4" />
                                        <ComboBoxItem Content="1.21.5" />
                                        <ComboBoxItem Content="1.21.3" />
                                        <ComboBoxItem Content="1.21.2" />
                                        <ComboBoxItem Content="1.21.1" />
                                        <ComboBoxItem Content="1.21" />
                                        <ComboBoxItem Content="1.20.4" />
                                        <ComboBoxItem Content="1.20.3" />
                                        <ComboBoxItem Content="1.20.2" />
                                        <ComboBoxItem Content="1.20.1" />
                                    </ComboBox>
                                </ui:CardControl.Content>
                            </ui:CardControl>

                            <!-- License -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock 
                                    Margin="0,0,0,4"
                                    FontWeight="SemiBold" 
                                    Text="License" />
                                <controls:WikiTooltip 
                                    WikiId="mod-licensing"
                                    Title="Mod Licensing"
                                    Category="General"
                                    Keywords="license,copyright,MIT,GPL,legal,distribution"
                                    Description="Licenses determine how others can use your mod. MIT is permissive and allows almost anything. GPL requires derivative works to be open source. 'All Rights Reserved' restricts usage. Choose based on how you want your mod to be shared and modified."
                                    Margin="8,0,0,4"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                            <ui:CardControl
                                ToolTip="Choose a license for your mod"
                                Margin="0,0,0,16">
                                <ui:CardControl.Content>
                                    <ComboBox
                                        x:Name="LicenseComboBox"
                                        IsEditable="True"
                                        Width="Auto"
                                        MinWidth="390">
                                        <ComboBoxItem Content="MIT License" />
                                        <ComboBoxItem Content="GNU Lesser General Public License v3.0 (LGPL-3.0)" />
                                        <ComboBoxItem Content="GNU General Public License v3.0 (GPL-3.0)" />
                                        <ComboBoxItem Content="Apache License 2.0" />
                                        <ComboBoxItem Content="Mozilla Public License 2.0" />
                                        <ComboBoxItem Content="All Rights Reserved" />
                                        <ComboBoxItem Content="Custom License" />
                                    </ComboBox>
                                </ui:CardControl.Content>
                            </ui:CardControl>

                            <!-- Description -->
                            <TextBlock 
                                Margin="0,0,0,4"
                                FontWeight="SemiBold" 
                                Text="Description (Optional)" />
                            <ui:TextBox
                                x:Name="DescriptionBox"
                                Margin="0,0,0,16"
                                PlaceholderText="A brief description of your mod"
                                Icon="{ui:SymbolIcon Comment24}"
                                ToolTip="Describe what your mod does"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                Height="80"
                                VerticalContentAlignment="Top"/>

                            <!-- Authors -->
                            <TextBlock 
                                Margin="0,0,0,4"
                                FontWeight="SemiBold" 
                                Text="Authors (Optional)" />
                            <ui:TextBox
                                x:Name="AuthorsBox"
                                Margin="0,0,0,16"
                                PlaceholderText="Comma-separated list of authors"
                                Icon="{ui:SymbolIcon People24}"
                                ToolTip="List the authors of the mod (comma-separated)"/>
                        </StackPanel>

                        <!-- Project Icon section -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock 
                                Margin="0,0,0,4"
                                FontWeight="SemiBold" 
                                Text="Project Icon (Optional)" />
                            <controls:WikiTooltip 
                                WikiId="mod-icon"
                                Title="Mod Icon"
                                Category="Textures"
                                Keywords="icon,texture,pack.png,64x64,branding"
                                Description="The mod icon appears in mod menus and represents your mod visually. It should be a 64x64 pixel PNG image that clearly represents your mod's theme or content. A good icon helps players identify your mod quickly."
                                Margin="8,0,0,4"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid x:Name="IconSection" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Initial Select Button (Visible when no icon selected) -->
                            <Border 
                                Grid.Column="0"
                                Width="60" 
                                Height="60" 
                                Background="{DynamicResource ControlFillColorTertiaryBrush}" 
                                CornerRadius="8">
                                <ui:Button
                                    x:Name="SelectIconButton"
                                    Width="60"
                                    Height="60"
                                    Icon="{ui:SymbolIcon Image24}"
                                    Appearance="Transparent"
                                    Click="SelectIconButton_Click"
                                    ToolTip="Select a PNG file for your mod's icon"/>
                            </Border>

                            <!-- Icon Preview (Hidden initially) -->
                            <Border 
                                Grid.Column="0"
                                Width="60" 
                                Height="60" 
                                Background="{DynamicResource ControlFillColorDefaultBrush}" 
                                CornerRadius="8"
                                Visibility="Collapsed">
                                <!-- Replaced Image with PngDisplay -->
                                <controls:PngDisplay
                                    x:Name="IconPreview"
                                    Width="48"
                                    Height="48"
                                    Visibility="Collapsed"
                                    AnimationEnabled="False"/>
                            </Border>

                            <!-- Control Buttons (Hidden initially) -->
                            <StackPanel
                                x:Name="IconControls"
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                Orientation="Horizontal"
                                Visibility="Collapsed">

                                <ui:Button
                                    x:Name="SwitchIconButton"
                                    Margin="0,0,8,0"
                                    Icon="{ui:SymbolIcon ArrowRepeatAll24}"
                                    Content="Switch Icon"
                                    Click="SwitchIconButton_Click"
                                    ToolTip="Change the selected icon"/>

                                <ui:Button
                                    x:Name="RemoveIconButton"
                                    Icon="{ui:SymbolIcon Delete24}"
                                    Content="Remove Icon"
                                    Appearance="Danger"
                                    Click="RemoveIconButton_Click"
                                    ToolTip="Remove the selected icon"/>
                            </StackPanel>
                        </Grid>

                        <!-- Resource Pack specific fields -->
                        <StackPanel x:Name="ResourcePackSpecificFields">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem.Content, ElementName=ModTypeComboBox}" Value="Resource Pack">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Minecraft Version for Resource Pack -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock 
                                    Margin="0,0,0,4"
                                    FontWeight="SemiBold" 
                                    Text="Target Minecraft Version" />
                                <controls:WikiTooltip 
                                    WikiId="minecraft-version-resource-pack"
                                    Title="Minecraft Version for Resource Packs"
                                    Category="Textures"
                                    Keywords="minecraft,version,resource pack,compatibility,assets,extraction"
                                    Description="Select the Minecraft version to target for your resource pack. This determines which textures and assets will be extracted for creating overrides. Different versions may have different pack formats and available textures."
                                    Margin="8,0,0,4"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                            <ui:CardControl
                                ToolTip="Select Minecraft version for texture extraction"
                                Margin="0,0,0,16">
                                <ui:CardControl.Content>
                                    <ComboBox
                                        x:Name="ResourcePackMinecraftVersionComboBox"
                                        Width="Auto"
                                        MinWidth="390">
                                        <ComboBoxItem Content="1.21.5" Tag="22"/>
                                        <ComboBoxItem Content="1.21.4" Tag="22"/>
                                        <ComboBoxItem Content="1.21.3" Tag="18"/>
                                        <ComboBoxItem Content="1.21.2" Tag="18"/>
                                        <ComboBoxItem Content="1.21.1" Tag="18"/>
                                        <ComboBoxItem Content="1.21" Tag="18"/>
                                        <ComboBoxItem Content="1.20.6" Tag="21"/>
                                        <ComboBoxItem Content="1.20.4" Tag="20"/>
                                        <ComboBoxItem Content="1.20.3" Tag="18"/>
                                        <ComboBoxItem Content="1.20.2" Tag="18"/>
                                        <ComboBoxItem Content="1.20.1" Tag="18"/>
                                    </ComboBox>
                                </ui:CardControl.Content>
                            </ui:CardControl>

                            <!-- Pack Format (auto-selected based on MC version) -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock 
                                    Margin="0,0,0,4"
                                    FontWeight="SemiBold" 
                                    Text="Pack Format" />
                                <controls:WikiTooltip 
                                    WikiId="pack-format-auto"
                                    Title="Pack Format (Auto-selected)"
                                    Category="Textures"
                                    Keywords="pack format,compatibility,minecraft version,automatic"
                                    Description="The pack format is automatically determined based on your selected Minecraft version. This ensures compatibility with the target Minecraft version."
                                    Margin="8,0,0,4"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                            <ui:TextBox
                                x:Name="PackFormatDisplayBox"
                                Margin="0,0,0,16"
                                IsReadOnly="True"
                                PlaceholderText="Auto-selected based on Minecraft version"
                                Icon="{ui:SymbolIcon Info24}"
                                ToolTip="Pack format is automatically determined"/>

                            <!-- Description -->
                            <TextBlock 
                                Margin="0,0,0,4"
                                FontWeight="SemiBold" 
                                Text="Description (Optional)" />
                            <ui:TextBox
                                x:Name="ResourcePackDescriptionBox"
                                Margin="0,0,0,16"
                                PlaceholderText="A brief description of your resource pack"
                                Icon="{ui:SymbolIcon Comment24}"
                                ToolTip="Describe what your resource pack changes"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                Height="80"
                                VerticalContentAlignment="Top"/>

                            <!-- Authors -->
                            <TextBlock 
                                Margin="0,0,0,4"
                                FontWeight="SemiBold" 
                                Text="Authors (Optional)" />
                            <ui:TextBox
                                x:Name="ResourcePackAuthorsBox"
                                Margin="0,0,0,16"
                                PlaceholderText="Comma-separated list of authors"
                                Icon="{ui:SymbolIcon People24}"
                                ToolTip="List the authors of the resource pack"/>
                        </StackPanel>

                        <!-- Advanced Options -->
                        <ui:CardExpander Margin="0,8,0,0" Header="Advanced Options" CornerRadius="8">
                            <StackPanel Margin="8,12,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox
                                        x:Name="IncludeReadmeCheckbox"
                                        Margin="0,0,8,8"
                                        IsChecked="True"
                                        Content="Add README.md File"
                                        ToolTip="Include README.md file on the project template?"/>
                                    <controls:WikiTooltip 
                                        Margin="0,0,0,8"
                                        WikiId="readme-file"
                                        Title="README File"
                                        Category="General"
                                        Keywords="readme,documentation,markdown,github"
                                        Description="A README.md file provides documentation for your mod, explaining what it does, how to install it, and any special requirements. It's essential for open source projects and helps users understand your mod."
                                        VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>
                </ScrollViewer>
                <ui:DynamicScrollBar 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Stretch" />
            </Grid>
        </Border>

        <!-- Button Panel -->
        <Grid 
            Grid.Row="3" 
            Margin="42,0,42,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button
                Grid.Column="1"
                ToolTip="Close without creating a project"
                Margin="0,0,8,0"
                Appearance="Secondary"
                Content="Cancel"
                Height="36"
                Width="100"
                Icon="{ui:SymbolIcon Dismiss24}"
                Click="CancelButton_Click"/>

            <ui:Button
                Grid.Column="2"
                Appearance="Primary"
                Content="Create Project"
                Height="36"
                Width="140"
                Icon="{ui:SymbolIcon Add24}"
                Click="CreateButton_Click"
                IsEnabled="{Binding AreFieldsValid}"
                ToolTip="Create a new mod project with these settings"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
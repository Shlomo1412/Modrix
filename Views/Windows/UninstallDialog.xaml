<ui:FluentWindow x:Class="Modrix.Views.Windows.UninstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Uninstall Modrix"
        Height="480"
        Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18" VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="Warning24" Width="40" Height="40" Margin="0,0,12,0" Foreground="Orange"/>
            <StackPanel>
                <TextBlock Text="Uninstall Modrix" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Are you sure you want to remove Modrix?" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </StackPanel>
        
        <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="18" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="The following will be removed:" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="&#8226; Modrix application files" Margin="0,0,0,4"/>
                    <TextBlock Text="&#8226; Desktop and Start Menu shortcuts" Margin="0,0,0,4"/>
                    <TextBlock Text="&#8226; File associations for .modrix files" Margin="0,0,0,4"/>
                    <TextBlock Text="&#8226; Registry entries" Margin="0,0,0,4"/>
                    <TextBlock Text="&#8226; System PATH entries" Margin="0,0,0,4"/>
                </StackPanel>
                
                <!-- User Data Options -->
                <Border Background="{DynamicResource ControlFillColorTertiaryBrush}" 
                        CornerRadius="8" 
                        Padding="12" 
                        Margin="0,8,0,8">
                    <StackPanel>
                        <TextBlock Text="User Data Options:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        
                        <CheckBox x:Name="DeleteProjectsCheckBox" 
                                  Content="Also delete my projects and user data" 
                                  FontSize="13"
                                  Margin="0,0,0,4"/>
                        
                        <TextBlock Text="Projects are stored in: %LocalAppData%\Modrix\Projects\" 
                                  FontSize="11" 
                                  FontStyle="Italic"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Margin="20,0,0,0"/>
                    </StackPanel>
                </Border>
                
                <TextBlock x:Name="PreservationNote"
                          Text="Note: Your projects and user data will be preserved." 
                          FontStyle="Italic" 
                          Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                          Margin="0,0,0,0"/>
                
                <!-- Progress Section (Initially Hidden) -->
                <StackPanel x:Name="ProgressSection" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBlock Text="Uninstalling..." FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                    <ProgressBar x:Name="UninstallProgress" Height="6" IsIndeterminate="True" Margin="0,0,0,8"/>
                    <TextBlock x:Name="ProgressText" Text="Starting uninstallation..." FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <StackPanel x:Name="ButtonsSection" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button x:Name="UninstallButton" Content="Uninstall Modrix" Appearance="Primary" Height="36" Margin="0,0,8,0" 
                      Icon="{ui:SymbolIcon Delete24}" Click="Uninstall_Click"/>
            <ui:Button x:Name="CancelButton" Content="Cancel" Height="36" Icon="{ui:SymbolIcon Dismiss24}" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
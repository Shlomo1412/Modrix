<ui:FluentWindow
    x:Class="Modrix.Views.Windows.ShareDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Share Project"
    Height="580"
    Width="520"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
 WindowBackdropType="Mica"
    WindowCornerPreference="Round"
  ExtendsContentIntoTitleBar="True"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

   <!-- Header -->
     <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18" VerticalAlignment="Center">
        <ui:SymbolIcon Symbol="Share24" Width="40" Height="40" Margin="0,0,12,0"/>
   <StackPanel>
  <TextBlock Text="Share Your Project" FontSize="22" FontWeight="Bold"/>
      <TextBlock Text="Create a shareable .modrix file for others to import" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Content -->
        <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="18" Margin="0,0,0,18">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
     <TextBlock Text="What's included in the .modrix file?" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
        
    <StackPanel Margin="0,0,0,16">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                 <ui:SymbolIcon Symbol="Checkmark16" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
         <TextBlock Text="Project settings (mod type, Minecraft version, etc.)" TextWrapping="Wrap"/>
        </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <ui:SymbolIcon Symbol="Checkmark16" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
   <TextBlock Text="All mod elements (items, blocks, etc.)" TextWrapping="Wrap"/>
              </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
    <ui:SymbolIcon Symbol="Checkmark16" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
    <TextBlock Text="Textures, sounds, and models" TextWrapping="Wrap"/>
         </StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
  <ui:SymbolIcon Symbol="Checkmark16" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
             <TextBlock Text="Custom and modified code files only" TextWrapping="Wrap"/>
  </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
         <ui:SymbolIcon Symbol="Checkmark16" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
             <TextBlock Text="Language/translation files" TextWrapping="Wrap"/>
         </StackPanel>
           </StackPanel>

        <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,16"/>

           <TextBlock Text="Smart Code Detection" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
     <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12">
              Modrix automatically detects which code files you've modified or added. Unmodified template files are excluded to keep the file size minimal. The project structure will be regenerated from templates on import.
          </TextBlock>

      <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,16"/>

                 <TextBlock Text="Project Summary" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
      <Grid Margin="0,0,0,8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
           <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
 <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
    
         <TextBlock Grid.Row="0" Grid.Column="0" Text="Mod Elements:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,4"/>
       <TextBlock x:Name="TxtModElementsCount" Grid.Row="0" Grid.Column="1" Text="0" FontWeight="SemiBold"/>
   
     <TextBlock Grid.Row="1" Grid.Column="0" Text="Resources:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,4"/>
   <TextBlock x:Name="TxtResourcesCount" Grid.Row="1" Grid.Column="1" Text="0" FontWeight="SemiBold"/>
         
          <TextBlock Grid.Row="2" Grid.Column="0" Text="New Code Files:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,4"/>
         <TextBlock x:Name="TxtNewCodeFilesCount" Grid.Row="2" Grid.Column="1" Text="0" FontWeight="SemiBold"/>
             
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Modified Files:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,4"/>
  <TextBlock x:Name="TxtModifiedFilesCount" Grid.Row="3" Grid.Column="1" Text="0" FontWeight="SemiBold"/>
  
         <TextBlock Grid.Row="4" Grid.Column="0" Text="Languages:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,4"/>
            <TextBlock x:Name="TxtLanguagesCount" Grid.Row="4" Grid.Column="1" Text="0" FontWeight="SemiBold"/>
     
    <TextBlock Grid.Row="5" Grid.Column="0" Text="Hash Tracking:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,4"/>
      <TextBlock x:Name="TxtHashStatus" Grid.Row="5" Grid.Column="1" Text="Checking..." FontWeight="SemiBold"/>
       </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Progress -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,12">
         <TextBlock x:Name="TxtProgress" Text="Preparing export..." Margin="0,0,0,8"/>
            <ProgressBar x:Name="ProgressBar" Height="4" IsIndeterminate="False" Value="0"/>
        </StackPanel>

<!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button x:Name="BtnShare"
         Content="Create .modrix File"
        Appearance="Primary"
    Width="160"
         Height="36"
   Margin="0,0,8,0"
   Icon="{ui:SymbolIcon Share24}"
      Click="BtnShare_Click"/>
      <ui:Button x:Name="BtnCancel"
   Content="Cancel"
            Width="100"
           Height="36"
           Appearance="Secondary"
        Icon="{ui:SymbolIcon Dismiss24}"
     Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>

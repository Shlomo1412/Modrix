<ui:FluentWindow
    x:Class="Modrix.Views.Windows.LoadingProjectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Creating Project"
    Width="480"
    Height="260"
    d:DesignWidth="480"
    d:DesignHeight="260"
    Background="#1A1A1A"
    Foreground="Gray"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    mc:Ignorable="d">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Header with Icon and Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18" VerticalAlignment="Center">
            <ui:ProgressRing Width="40" Height="40" Margin="0,0,12,0" IsIndeterminate="True" />
            <StackPanel>
                <TextBlock Text="Creating New Mod Project" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Please wait while we set up your project..." FontSize="14" Foreground="Gray"/>
            </StackPanel>
        </StackPanel>
        <!-- Main Content Area -->
        <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="18" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock x:Name="CurrentTaskText" Text="Initializing..." FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                <ui:CardControl Margin="0,8,0,0">
                    <ProgressBar 
                        x:Name="TaskProgressBar"
                        Height="10" 
                        Width="365"
                        Minimum="0"
                        Maximum="100"/>
                </ui:CardControl>
                <ui:ProgressRing
                    x:Name="LoadingRing"
                    IsIndeterminate="True"
                    Margin="0,12,0,0" 
                    Width="28"
                    Height="28"/>
            </StackPanel>
        </Border>
        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button
                x:Name="CancelButton"
                Content="Cancel"
                Appearance="Danger"
                Height="36"
                Width="120"
                Icon="{ui:SymbolIcon Dismiss24}"
                Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
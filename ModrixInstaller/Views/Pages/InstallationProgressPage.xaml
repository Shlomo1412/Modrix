<Page
    x:Class="ModrixInstaller.Views.Pages.InstallationProgressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="InstallationProgressPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock
                Text="Installing Modrix"
                FontSize="28"
                FontWeight="Bold"
                Margin="0,0,0,8" />
            
            <TextBlock
                Text="Please wait while Modrix is being installed on your computer..."
                FontSize="14" />
        </StackPanel>

        <!-- Progress Section -->
        <Border Grid.Row="1" 
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,20">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Margin="0,0,8,0" />
                    <TextBlock Text="Installation Progress" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
                
                <!-- Main Progress Bar -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <ProgressBar Grid.Column="0"
                                Value="{Binding ProgressPercentage}"
                                Maximum="100"
                                Height="8"
                                VerticalAlignment="Center" />
                    
                    <TextBlock Grid.Column="1"
                               Text="{Binding ProgressPercentage, StringFormat={}{0}%}"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Status Information -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding CurrentStatus}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Margin="0,0,0,4" />
                        
                        <TextBlock Text="{Binding CurrentStep}"
                                   FontSize="12" />
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="Elapsed Time:"
                                   FontSize="11"
                                   HorizontalAlignment="Right" />
                        
                        <TextBlock Text="{Binding ElapsedTime}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Error Display -->
        <Border Grid.Row="2"
                Background="#FFEB3C4B"
                BorderBrush="#FFDC2626"
                BorderThickness="1"
                CornerRadius="4"
                Padding="15"
                Margin="0,20,0,0"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ErrorCircle24" 
                               FontSize="16" 
                               Foreground="White"
                               Margin="0,0,10,0" />
                <StackPanel>
                    <TextBlock Text="Installation Error" 
                               FontWeight="SemiBold" 
                               Foreground="White" />
                    <TextBlock Text="{Binding ErrorMessage}" 
                               Foreground="White" 
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
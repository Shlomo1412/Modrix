<Page x:Class="ModrixInstaller.Views.Pages.LicensePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:ModrixInstaller.Views.Pages"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance local:LicensePage, IsDesignTimeCreatable=False}"
      d:DesignHeight="650"
      d:DesignWidth="900"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="3,3,12,12" 
                Padding="16,8,16,12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Document24" Width="24" Height="24" Margin="0,0,8,0"/>
                <StackPanel>
                    <TextBlock Text="License Agreement" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Please review and accept the MIT License" FontSize="12" 
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- License Content -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- License Text -->
            <ui:Card Grid.Column="0" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:SymbolIcon Symbol="Document24" Width="20" Height="20" Margin="0,0,6,0"/>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="MIT License"/>
                    </StackPanel>

                    <Border CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Accent -->
                            <Border Grid.Column="0" CornerRadius="8,0,0,8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#4C7DFF" Offset="0"/>
                                        <GradientStop Color="#2850B7" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ScrollViewer Grid.Column="1" Margin="12,10,12,10" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible">
                                <TextBlock 
                                    Text="{Binding ViewModel.LicenseText}" 
                                    FontFamily="Consolas" 
                                    FontSize="11" 
                                    TextWrapping="Wrap"
                                    LineHeight="16"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </StackPanel>
            </ui:Card>

            <!-- Right Panel -->
            <StackPanel Grid.Column="2">
                <!-- License Summary -->
                <ui:Card Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Info24" Width="18" Height="18" Margin="0,0,6,0"/>
                            <TextBlock Text="Key Terms" FontWeight="SemiBold" FontSize="14"/>
                        </StackPanel>

                        <StackPanel>
                            <Border Background="#2F3037" Padding="8,6" CornerRadius="6" Margin="0,0,0,4" 
                                   BorderBrush="#44464F" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Checkmark24" Width="14" Height="14" Margin="0,0,6,0" Foreground="#6EC177"/>
                                    <TextBlock Text="Commercial use" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#2F3037" Padding="8,6" CornerRadius="6" Margin="0,0,0,4" 
                                   BorderBrush="#44464F" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Checkmark24" Width="14" Height="14" Margin="0,0,6,0" Foreground="#6EC177"/>
                                    <TextBlock Text="Modification" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#3E2F1F" Padding="8,6" CornerRadius="6" Margin="0,0,0,4" 
                                   BorderBrush="#5C4A2F" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Important24" Width="14" Height="14" Margin="0,0,6,0" Foreground="#FFB366"/>
                                    <TextBlock Text="Include notice" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#3E2424" Padding="8,6" CornerRadius="6" 
                                   BorderBrush="#5C3838" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Warning24" Width="14" Height="14" Margin="0,0,6,0" Foreground="#FF6B5E"/>
                                    <TextBlock Text="No warranty" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                
            </StackPanel>
        </Grid>

        <!-- License Acceptance -->
        <ui:Card Grid.Row="2" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" Width="20" Height="20" Margin="0,0,8,0"/>
                        <TextBlock Text="License Acceptance" FontWeight="SemiBold" FontSize="14"/>
                    </StackPanel>
                    <TextBlock Text="You must accept the license terms to proceed with installation" 
                              FontSize="12" 
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                
                <CheckBox 
                    Grid.Column="1"
                    x:Name="AcceptLicenseCheckBox"
                    IsChecked="{Binding ViewModel.IsAccepted}"
                    Content="I Accept"
                    FontSize="14"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </Grid>
        </ui:Card>
    </Grid>
</Page>
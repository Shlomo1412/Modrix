<Page x:Class="ModrixInstaller.Views.Pages.LicensePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:ModrixInstaller.Views.Pages"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance local:LicensePage, IsDesignTimeCreatable=False}"
      d:DesignHeight="650"
      d:DesignWidth="900"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock 
                FontSize="32" 
                FontWeight="Bold" 
                Text="License Agreement" />
            <TextBlock 
                Margin="0,8,0,0"
                FontSize="16" 
                Opacity="0.8"
                Text="Please read and accept the MIT License to continue" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <!-- License Content -->
                <ui:Card Margin="0,0,0,25">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <ui:SymbolIcon Symbol="Document24" Margin="0,0,8,0" />
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="MIT License" />
                        </StackPanel>

                        <Border 
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="16"
                            MaxHeight="300">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock 
                                    Text="{Binding ViewModel.LicenseText}" 
                                    FontFamily="Consolas" 
                                    FontSize="12" 
                                    TextWrapping="Wrap"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!-- License Acceptance -->
                <ui:Card Margin="0,0,0,25">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <ui:SymbolIcon Grid.Column="0" Symbol="ShieldCheckmark24" Margin="0,0,15,0" />
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="License Acceptance" />
                            <TextBlock 
                                Margin="0,4,0,0"
                                Opacity="0.8"
                                Text="You must accept the license terms to proceed with installation" />
                        </StackPanel>
                        
                        <CheckBox 
                            Grid.Column="2"
                            x:Name="AcceptLicenseCheckBox"
                            IsChecked="{Binding ViewModel.IsAccepted}"
                            Content="I Accept"
                            FontSize="14"
                            FontWeight="SemiBold" />
                    </Grid>
                </ui:Card>

                <!-- License Summary -->
                <ui:Card Margin="0,0,0,25" Background="{DynamicResource AccentFillColorSecondaryBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <ui:SymbolIcon Symbol="Info24" Margin="0,0,8,0" />
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="License Summary" />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock 
                                Text="• ✅ Commercial and private use allowed" 
                                Margin="0,0,0,4" />
                            <TextBlock 
                                Text="• ✅ Modification and distribution permitted" 
                                Margin="0,0,0,4" />
                            <TextBlock 
                                Text="• ✅ Patent use granted" 
                                Margin="0,0,0,4" />
                            <TextBlock 
                                Text="• ❗ Must include copyright and license notice" 
                                Margin="0,0,0,4" />
                            <TextBlock 
                                Text="• ⚠️ Software provided 'as is' without warranty" 
                                Margin="0,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- Warning -->
                <ui:Card Margin="0,0,0,25" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <ui:SymbolIcon Grid.Column="0" Symbol="Warning24" Margin="0,0,12,0" Foreground="Orange" />
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="SemiBold" Text="Important Notice" />
                            <TextBlock 
                                Margin="0,4,0,0"
                                Text="Declining the license agreement will close the installer. You must accept these terms to install Modrix." 
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ui:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
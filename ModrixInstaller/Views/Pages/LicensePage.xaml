<Page
    x:Class="ModrixInstaller.Views.Pages.LicensePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="LicensePage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock
                Text="{Binding LicenseTitle}"
                FontSize="28"
                FontWeight="Bold"
                Margin="0,0,0,8" />
            
            <TextBlock
                Text="{Binding LicenseSubtitle}"
                FontSize="14" />
        </StackPanel>

        <!-- License Text -->
        <Border Grid.Row="1"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,0,0,20">
            <ScrollViewer Padding="20"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock
                    Text="{Binding LicenseText}"
                    FontFamily="Consolas, Courier New, monospace"
                    FontSize="11"
                    LineHeight="16"
                    TextWrapping="Wrap"
                    Background="Transparent" />
            </ScrollViewer>
        </Border>

        <!-- License Agreement -->
        <StackPanel Grid.Row="2">
            <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel>
                    <CheckBox
                        x:Name="LicenseCheckBox"
                        Content="I have read and agree to the license terms and conditions"
                        IsChecked="{Binding IsLicenseAccepted, Mode=TwoWay}"
                        FontSize="14"
                        Margin="0,0,0,15" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:SymbolIcon Symbol="Warning24" 
                                       FontSize="16" 
                                       Foreground="Orange"
                                       Margin="0,0,8,0" />
                        <TextBlock
                            Text="You must accept the license agreement to continue with the installation."
                            FontSize="12"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        Margin="0,15,0,0">
                <ui:Button Content="Print License"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Print24}"
                           Margin="0,0,10,0"
                           Click="PrintLicense_Click" />
                
                <ui:Button Content="Save License"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Save24}"
                           Click="SaveLicense_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
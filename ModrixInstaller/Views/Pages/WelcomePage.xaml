<Page
    x:Class="ModrixInstaller.Views.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:ModrixInstaller.ViewModels.Pages"
    Title="WelcomePage"
    d:DataContext="{d:DesignInstance Type=viewModels:WelcomePageViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid Margin="40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Main Content -->
        <StackPanel Grid.Column="0" Margin="0,0,40,0">
            <!-- Welcome Title -->
            <TextBlock
                Text="{Binding WelcomeTitle}"
                FontSize="32"
                FontWeight="Bold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Margin="0,0,0,20" />

            <!-- Welcome Message -->
            <TextBlock
                Text="{Binding WelcomeMessage}"
                FontSize="14"
                LineHeight="22"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Margin="0,0,0,30" />

            <!-- Version and Copyright -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <ui:Badge Content="{Binding VersionInfo}" 
                          Appearance="Secondary"
                          Margin="0,0,10,0" />
                <TextBlock
                    Text="{Binding CopyrightInfo}"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Links -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <ui:HyperlinkButton Content="?? Project Website" 
                                    NavigateUri="https://github.com/Shlomo1412/Modrix"
                                    Margin="0,0,20,0" />
                <ui:HyperlinkButton Content="?? Documentation" 
                                    NavigateUri="https://github.com/Shlomo1412/Modrix/wiki"
                                    Margin="0,0,20,0" />
                <ui:HyperlinkButton Content="?? Report Issues" 
                                    NavigateUri="https://github.com/Shlomo1412/Modrix/issues" />
            </StackPanel>
        </StackPanel>

        <!-- Side Panel -->
        <Border Grid.Column="1"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
            <StackPanel>
                <!-- System Requirements -->
                <TextBlock
                    Text="?? System Requirements"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,0,0,15" />

                <TextBlock
                    Text="{Binding SystemRequirements}"
                    FontSize="12"
                    LineHeight="18"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,20" />

                <!-- What's New -->
                <TextBlock
                    Text="?? What's New"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,0,0,15" />

                <StackPanel>
                    <TextBlock Text="- Modern WPF-UI interface" 
                               FontSize="12" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,2" />
                    <TextBlock Text="- Enhanced mod development tools" 
                               FontSize="12" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,2" />
                    <TextBlock Text="- Improved resource management" 
                               FontSize="12" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,2" />
                    <TextBlock Text="- Better Fabric and Forge support" 
                               FontSize="12" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,2" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
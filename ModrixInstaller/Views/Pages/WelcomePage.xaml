<Page
    x:Class="ModrixInstaller.Views.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="WelcomePage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="60">
        <!-- Single column layout without right sidebar -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
            <!-- Welcome Title -->
            <TextBlock
                Text="{Binding WelcomeTitle}"
                FontSize="36"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,0,0,20" />

            <!-- Welcome Message -->
            <TextBlock
                Text="{Binding WelcomeMessage}"
                FontSize="16"
                LineHeight="24"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                Margin="0,0,0,40" />

            <!-- System Requirements Section -->
            <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="30"
                    Margin="0,0,0,30">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="20" Margin="0,0,10,0" />
                        <TextBlock
                            Text="System Requirements"
                            FontSize="18"
                            FontWeight="SemiBold" />
                    </StackPanel>

                    <TextBlock
                        Text="{Binding SystemRequirements}"
                        FontSize="14"
                        LineHeight="20"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center"
                        TextAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Version and Copyright -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                <ui:Badge Content="{Binding VersionInfo}" 
                          Appearance="Secondary"
                          Margin="0,0,15,0" />
                <TextBlock
                    Text="{Binding CopyrightInfo}"
                    FontSize="12"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Links -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <ui:Button Content="Project Website"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Globe24}"
                           Margin="0,0,15,0"
                           Click="OpenWebsite_Click" />
                <ui:Button Content="Documentation"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Book24}"
                           Margin="0,0,15,0"
                           Click="OpenDocumentation_Click" />
                <ui:Button Content="Report Issues"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Bug24}"
                           Click="ReportIssues_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
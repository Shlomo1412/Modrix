<Page
    x:Class="ModrixInstaller.Views.Pages.ShortcutsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ModrixInstaller.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="ShortcutsPage"
    d:DataContext="{d:DesignInstance local:ShortcutsPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="650"
    d:DesignWidth="900"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="3,3,12,12" 
                Padding="16,8,16,12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Link24" Width="24" Height="24" Margin="0,0,8,0"/>
                <StackPanel>
                    <TextBlock Text="Shortcuts Configuration" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Choose where to create shortcuts for easy access" FontSize="12" 
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column -->
            <StackPanel Grid.Column="0">
                <!-- Desktop Shortcut -->
                <ui:Card Margin="0,0,0,8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#1E2A3E" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Desktop24" Foreground="#4C7DFF" Width="18" Height="18" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="Desktop Shortcut" />
                            <TextBlock 
                                Margin="0,2,0,0"
                                FontSize="11"
                                Opacity="0.8"
                                Text="Create a shortcut on your desktop" />
                        </StackPanel>
                        
                        <ui:ToggleSwitch 
                            Grid.Column="2"
                            x:Name="DesktopShortcutToggle"
                            IsChecked="{Binding ViewModel.CreateDesktopShortcut}" />
                    </Grid>
                </ui:Card>

                <!-- Start Menu Shortcut -->
                <ui:Card Margin="0,0,0,8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#1E2A3E" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Apps24" Foreground="#4C7DFF" Width="18" Height="18" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="Start Menu Shortcut" />
                            <TextBlock 
                                Margin="0,2,0,0"
                                FontSize="11"
                                Opacity="0.8"
                                Text="Add Modrix to your Start Menu" />
                        </StackPanel>
                        
                        <ui:ToggleSwitch 
                            Grid.Column="2"
                            x:Name="StartMenuShortcutToggle"
                            IsChecked="{Binding ViewModel.CreateStartMenuShortcut}" />
                    </Grid>
                </ui:Card>

                <!-- Quick Launch Shortcut -->
                <ui:Card Margin="0,0,0,8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#1E2A3E" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Rocket24" Foreground="#4C7DFF" Width="18" Height="18" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="Quick Launch Toolbar" />
                            <TextBlock 
                                Margin="0,2,0,0"
                                FontSize="11"
                                Opacity="0.8"
                                Text="Add to Quick Launch (if available)" />
                        </StackPanel>
                        
                        <ui:ToggleSwitch 
                            Grid.Column="2"
                            x:Name="QuickLaunchShortcutToggle"
                            IsChecked="{Binding ViewModel.CreateQuickLaunchShortcut}" />
                    </Grid>
                </ui:Card>

                <!-- Taskbar Pin -->
                <ui:Card Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#1E2A3E" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Pin24" Foreground="#4C7DFF" Width="18" Height="18" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="Pin to Taskbar" />
                            <TextBlock 
                                Margin="0,2,0,0"
                                FontSize="11"
                                Opacity="0.8"
                                Text="Pin Modrix to your taskbar" />
                        </StackPanel>
                        
                        <ui:ToggleSwitch 
                            Grid.Column="2"
                            x:Name="TaskbarPinToggle"
                            IsChecked="{Binding ViewModel.PinToTaskbar}" />
                    </Grid>
                </ui:Card>
            </StackPanel>

            <!-- Right Column -->
            <StackPanel Grid.Column="2">
                <!-- File Association -->
                <ui:Card Margin="0,0,0,8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#1E2A3E" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="DocumentFolder24" Foreground="#4C7DFF" Width="18" Height="18" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="Associate Project Files" />
                            <TextBlock 
                                Margin="0,2,0,0"
                                FontSize="11"
                                Opacity="0.8"
                                Text="Associate .modrix files with Modrix" />
                        </StackPanel>
                        
                        <ui:ToggleSwitch 
                            Grid.Column="2"
                            x:Name="FileAssociationToggle"
                            IsChecked="{Binding ViewModel.AssociateProjectFiles}" />
                    </Grid>
                </ui:Card>

                <!-- System PATH -->
                <ui:Card Margin="0,0,0,8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#1E2A3E" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="WindowConsole20" Foreground="#4C7DFF" Width="18" Height="18" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="Add to System PATH" />
                            <TextBlock 
                                Margin="0,2,0,0"
                                FontSize="11"
                                Opacity="0.8"
                                Text="Run Modrix from command line" />
                        </StackPanel>
                        
                        <ui:ToggleSwitch 
                            Grid.Column="2"
                            x:Name="SystemPATHToggle"
                            IsChecked="{Binding ViewModel.AddToSystemPath}" />
                    </Grid>
                </ui:Card>

                <!-- Summary Card -->
                <ui:Card Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="Info24" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Summary"/>
                        </StackPanel>

                        <Border CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Info accent -->
                                <Border Grid.Column="0" CornerRadius="8,0,0,8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#9C6BFF" Offset="0"/>
                                            <GradientStop Color="#6A46C8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ScrollViewer Grid.Column="1" Margin="12,10,12,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock x:Name="SummaryText" 
                                              Text="{Binding ViewModel.ShortcutSummary}" 
                                              TextWrapping="Wrap" 
                                              FontSize="12"
                                              LineHeight="16" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
<Page
    x:Class="ModrixInstaller.Views.Pages.CompletePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="CompletePage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Main Content -->
        <StackPanel Grid.Column="0" Margin="0,0,40,0">
            <!-- Success Animation -->
            <Grid Height="120" Margin="0,0,0,30">
                <Ellipse Width="100" Height="100"
                         Fill="{DynamicResource SystemAccentColorPrimary}"
                         Opacity="0.3"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
                
                <ui:SymbolIcon Symbol="CheckmarkCircle48"
                               FontSize="64"
                               Foreground="{DynamicResource SystemAccentColorPrimary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
            </Grid>

            <!-- Completion Title -->
            <TextBlock
                Text="{Binding CompletionTitle}"
                FontSize="32"
                FontWeight="Bold"
                TextAlignment="Center"
                Margin="0,0,0,20" />

            <!-- Completion Message -->
            <TextBlock
                Text="{Binding CompletionMessage}"
                FontSize="16"
                LineHeight="24"
                TextWrapping="Wrap"
                TextAlignment="Center"
                Margin="0,0,0,30" />

            <!-- Launch Option -->
            <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,30">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <ui:SymbolIcon Symbol="Play24" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock Text="Launch Options" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    
                    <CheckBox Content="Launch Modrix now"
                              IsChecked="{Binding RunAfterInstall, Mode=TwoWay}"
                              FontSize="14"
                              Margin="0,0,0,15" />
                    
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Launch Modrix"
                                   Command="{Binding LaunchModrixCommand}"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Play24}"
                                   Margin="0,0,10,0" />
                        
                        <ui:Button Content="Open Installation Folder"
                                   Command="{Binding OpenInstallationFolderCommand}"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon FolderOpen24}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Links -->
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0">
                <ui:Button Content="Visit Website"
                           Command="{Binding OpenWebsiteCommand}"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Globe24}"
                           Margin="0,0,15,0" />
                <ui:Button Content="Release Notes"
                           Command="{Binding ViewReleaseNotesCommand}"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Document24}"
                           Margin="0,0,15,0" />
                <ui:Button Content="Join Discord"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Chat24}"
                           Click="JoinDiscord_Click" />
            </StackPanel>
        </StackPanel>

        <!-- Side Panel -->
        <Border Grid.Column="1"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
            <StackPanel>
                <!-- Installation Summary -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <ui:SymbolIcon Symbol="Clipboard24" FontSize="16" Margin="0,0,8,0" />
                    <TextBlock
                        Text="Installation Summary"
                        FontSize="16"
                        FontWeight="SemiBold" />
                </StackPanel>

                <TextBlock
                    Text="{Binding InstallationSummary}"
                    FontSize="12"
                    LineHeight="18"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,20" />

                <!-- Next Steps -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <ui:SymbolIcon Symbol="Rocket24" FontSize="16" Margin="0,0,8,0" />
                    <TextBlock
                        Text="Next Steps"
                        FontSize="16"
                        FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="1. Launch Modrix and explore the interface" 
                               FontSize="12" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,2" />
                    <TextBlock Text="2. Create your first mod project" 
                               FontSize="12" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,2" />
                    <TextBlock Text="3. Check out the documentation and tutorials" 
                               FontSize="12" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,2" />
                    <TextBlock Text="4. Join our community for support" 
                               FontSize="12" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,2" />
                </StackPanel>

                <!-- Support Info -->
                <StackPanel Orientation="Horizontal" Margin="0,20,0,15">
                    <ui:SymbolIcon Symbol="Question24" FontSize="16" Margin="0,0,8,0" />
                    <TextBlock
                        Text="Need Help?"
                        FontSize="16"
                        FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <ui:SymbolIcon Symbol="Book24" FontSize="12" Margin="0,0,5,0" />
                        <TextBlock Text="Documentation: github.com/Shlomo1412/Modrix/wiki" 
                                   FontSize="11" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <ui:SymbolIcon Symbol="Bug24" FontSize="12" Margin="0,0,5,0" />
                        <TextBlock Text="Issues: github.com/Shlomo1412/Modrix/issues" 
                                   FontSize="11" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <ui:SymbolIcon Symbol="Chat24" FontSize="12" Margin="0,0,5,0" />
                        <TextBlock Text="Discord: discord.gg/modrix" 
                                   FontSize="11" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
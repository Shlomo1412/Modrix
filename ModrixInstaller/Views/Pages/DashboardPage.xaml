<Page
    x:Class="ModrixInstaller.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ModrixInstaller.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DashboardPage"
    d:DataContext="{d:DesignInstance local:DashboardPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="3,3,12,12" 
                Padding="16,8,16,12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Home24" Width="24" Height="24" Margin="0,0,8,0"/>
                <StackPanel>
                    <TextBlock Text="Welcome to Modrix Installer" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Your gateway to the Modrix development environment" FontSize="12" 
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ui:Card Grid.Row="1" Padding="24">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ImageIcon 
                    Width="100" Height="100"
                    Source="pack://application:,,,/Assets/wpfui-icon-256.png"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20" />

                <TextBlock 
                    Text="Ready to Install Modrix"
                    FontSize="24" 
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12" />

                <TextBlock 
                    Text="This installer will guide you through the process of downloading and installing Modrix from GitHub releases."
                    FontSize="14" 
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Opacity="0.8"
                    MaxWidth="400"
                    LineHeight="20"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20" />

                <!-- Counter Test (if needed for development) -->
                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                        CornerRadius="8" Padding="16" Margin="0,0,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:Button
                            Command="{Binding ViewModel.CounterIncrementCommand, Mode=OneWay}"
                            Content="Test Counter"
                            Icon="{ui:SymbolIcon Add24}"
                            Appearance="Secondary" />
                        <TextBlock
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="{Binding ViewModel.Counter, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ui:Card>
    </Grid>
</Page>

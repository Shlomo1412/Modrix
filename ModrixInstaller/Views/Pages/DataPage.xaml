<Page
    x:Class="ModrixInstaller.Views.Pages.DataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ModrixInstaller.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="AboutPage"
    d:DataContext="{d:DesignInstance local:DataPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="3,3,12,12" 
                Padding="16,8,16,12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Image Source="pack://application:,,,/Assets/wpfui-icon-256.png" Width="32" Height="32" Margin="0,0,8,0"/>
                <StackPanel>
                    <TextBlock Text="Modrix Installer" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Learn more about this installer application" FontSize="12" 
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column -->
            <StackPanel Grid.Column="0">
                <!-- About Section -->
                <ui:Card Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="Info24" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="About"/>
                        </StackPanel>

                        <Border CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Accent -->
                                <Border Grid.Column="0" CornerRadius="8,0,0,8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#4C7DFF" Offset="0"/>
                                            <GradientStop Color="#2850B7" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,10,12,12">
                                    <!-- Version badge -->
                                    <Border Background="#2F3037" Padding="8,4" CornerRadius="12" Margin="0,0,0,8" 
                                           BorderBrush="#44464F" BorderThickness="1" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Tag24" Width="14" Height="14" Margin="0,0,4,0"/>
                                            <TextBlock Text="Version 1.0.0" FontSize="11"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock 
                                        Text="The Modrix Installer provides a beautiful, user-friendly interface for downloading and installing Modrix from GitHub releases."
                                        TextWrapping="Wrap"
                                        LineHeight="18"
                                        FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!-- Features Section -->
                <ui:Card Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="CheckboxChecked24" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Features"/>
                        </StackPanel>

                        <Border CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Accent -->
                                <Border Grid.Column="0" CornerRadius="8,0,0,8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#6EC177" Offset="0"/>
                                            <GradientStop Color="#4A8A52" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,10,12,12">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="Checkmark24" Foreground="#6EC177" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="Download from GitHub releases" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="Checkmark24" Foreground="#6EC177" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="Version selection and management" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="Checkmark24" Foreground="#6EC177" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="Custom installation paths" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="Checkmark24" Foreground="#6EC177" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="Automatic shortcut creation" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Checkmark24" Foreground="#6EC177" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="Administrator privilege handling" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <!-- Right Column -->
            <StackPanel Grid.Column="2">
                <!-- Links Section -->
                <ui:Card Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="Link24" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Links"/>
                        </StackPanel>

                        <Border CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Accent -->
                                <Border Grid.Column="0" CornerRadius="8,0,0,8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#9C6BFF" Offset="0"/>
                                            <GradientStop Color="#6A46C8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,10,12,12">
                                    <ui:Button 
                                        Content="Modrix Repository"
                                        Icon="{ui:SymbolIcon Code24}"
                                        Command="{Binding ViewModel.OpenRepositoryCommand}"
                                        Appearance="Secondary"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,8" />
                                    <ui:Button 
                                        Content="Report Issues"
                                        Icon="{ui:SymbolIcon Bug24}"
                                        Command="{Binding ViewModel.OpenIssuesCommand}" 
                                        Appearance="Secondary"
                                        HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!-- App Icon Display -->
                <ui:Card Padding="16">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:ImageIcon 
                            Width="80" Height="80"
                            Source="pack://application:,,,/Assets/wpfui-icon-256.png"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,10" />
                        <TextBlock 
                            Text="Modrix Installer"
                            FontSize="14" 
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,4" />
                        <TextBlock 
                            Text="Modern installer experience"
                            FontSize="11" 
                            Opacity="0.7"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </Grid>
    </Grid>
</Page>

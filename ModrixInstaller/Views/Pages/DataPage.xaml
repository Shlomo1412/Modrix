<Page
    x:Class="ModrixInstaller.Views.Pages.DataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ModrixInstaller.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="AboutPage"
    d:DataContext="{d:DesignInstance local:DataPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600">
            
            <!-- App Icon -->
            <ui:ImageIcon 
                Width="128" Height="128"
                Source="pack://application:,,,/Assets/wpfui-icon-256.png"
                HorizontalAlignment="Center"
                Margin="0,0,0,25" />
            
            <!-- Title -->
            <TextBlock 
                FontSize="32" 
                FontWeight="Bold" 
                Text="Modrix Installer"
                HorizontalAlignment="Center"
                Margin="0,0,0,25" />
            
            <!-- Version -->
            <TextBlock 
                FontSize="16" 
                Opacity="0.8"
                Text="Version 1.0.0"
                HorizontalAlignment="Center"
                Margin="0,0,0,25" />
            
            <!-- Description -->
            <ui:Card Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock 
                        FontSize="18" 
                        FontWeight="SemiBold" 
                        Text="About Modrix Installer" 
                        Margin="0,0,0,10" />
                    <TextBlock 
                        TextWrapping="Wrap"
                        LineHeight="22"
                        Text="The Modrix Installer allows you to easily download and install Modrix from GitHub releases. It provides a beautiful, user-friendly interface for selecting versions, choosing installation locations, and managing the installation process." />
                </StackPanel>
            </ui:Card>
            
            <!-- Features -->
            <ui:Card Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock 
                        FontSize="18" 
                        FontWeight="SemiBold" 
                        Text="Features" 
                        Margin="0,0,0,10" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Checkmark24" Foreground="Green" Margin="0,0,8,0" />
                            <TextBlock Text="Download from GitHub releases" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Checkmark24" Foreground="Green" Margin="0,0,8,0" />
                            <TextBlock Text="Version selection and management" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Checkmark24" Foreground="Green" Margin="0,0,8,0" />
                            <TextBlock Text="Custom installation paths" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Checkmark24" Foreground="Green" Margin="0,0,8,0" />
                            <TextBlock Text="Automatic shortcut creation" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Checkmark24" Foreground="Green" Margin="0,0,8,0" />
                            <TextBlock Text="Administrator privilege handling" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ui:Card>
            
            <!-- Links -->
            <ui:Card>
                <StackPanel>
                    <TextBlock 
                        FontSize="18" 
                        FontWeight="SemiBold" 
                        Text="Links" 
                        Margin="0,0,0,15" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button 
                            Content="Modrix Repository"
                            Icon="Link24"
                            Command="{Binding ViewModel.OpenRepositoryCommand}"
                            Margin="0,0,15,0" />
                        <ui:Button 
                            Content="Report Issues"
                            Icon="Bug24"
                            Command="{Binding ViewModel.OpenIssuesCommand}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
            
        </StackPanel>
    </Grid>
</Page>

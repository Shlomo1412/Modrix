<Page
    x:Class="ModrixInstaller.Views.Pages.InstallationOptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:ModrixInstaller.ViewModels.Pages"
    Title="InstallationOptionsPage"
    d:DataContext="{d:DesignInstance Type=viewModels:InstallationOptionsViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <ScrollViewer Margin="40" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Header -->
            <StackPanel Margin="0,0,0,30">
                <TextBlock
                    Text="Installation Options"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,0,0,8" />
                
                <TextBlock
                    Text="Configure your Modrix installation settings"
                    FontSize="14"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Installation Path -->
            <Expander Header="Installation Location"
                      IsExpanded="True"
                      Margin="0,0,0,20">
                <StackPanel Margin="20">
                    <TextBlock Text="Choose where to install Modrix:"
                               FontSize="14"
                               Margin="0,0,0,10"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding InstallPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Installation directory..."
                                    Margin="0,0,10,0" />
                        
                        <ui:Button Grid.Column="1"
                                   Content="Browse"
                                   Command="{Binding BrowseInstallPathCommand}"
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   Appearance="Secondary"
                                   Margin="0,0,10,0" />
                        
                        <ui:Button Grid.Column="2"
                                   Content="Reset"
                                   Command="{Binding ResetToDefaultCommand}"
                                   Icon="{ui:SymbolIcon ArrowReset24}"
                                   Appearance="Secondary" />
                    </Grid>

                    <!-- Validation Message -->
                    <Border Background="#FFEB3C4B"
                            BorderBrush="#FFDC2626"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10"
                            Margin="0,10,0,0"
                            Visibility="{Binding IsInstallPathValid, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel>
                            <TextBlock Text="Invalid Installation Path" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="{Binding InstallPathValidationMessage}" Foreground="White" />
                        </StackPanel>
                    </Border>

                    <!-- Disk Space Info -->
                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Required space:" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding RequiredSpace}" FontSize="12" FontWeight="SemiBold" Margin="5,0,15,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Available space:" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding AvailableSpace}" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Low Disk Space Warning -->
                    <Border Background="#FFFFC107"
                            BorderBrush="#FFFF9800"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10"
                            Margin="0,10,0,0"
                            Visibility="{Binding HasEnoughSpace, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel>
                            <TextBlock Text="Low Disk Space" FontWeight="SemiBold" Foreground="Black" />
                            <TextBlock Text="The selected drive may not have enough free space for the installation." Foreground="Black" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>

            <!-- Shortcuts -->
            <Expander Header="Shortcuts" Margin="0,0,0,20">
                <StackPanel Margin="20">
                    <CheckBox Content="Create desktop shortcut"
                              IsChecked="{Binding CreateDesktopShortcut, Mode=TwoWay}"
                              Margin="0,0,0,10" />
                    
                    <CheckBox Content="Create Start Menu shortcut"
                              IsChecked="{Binding CreateStartMenuShortcut, Mode=TwoWay}" />
                </StackPanel>
            </Expander>

            <!-- Additional Options -->
            <Expander Header="Additional Options" Margin="0,0,0,20">
                <StackPanel Margin="20">
                    <CheckBox Content="Run Modrix after installation"
                              IsChecked="{Binding RunAfterInstall, Mode=TwoWay}"
                              Margin="0,0,0,10" />
                    
                    <CheckBox Content="Check for updates automatically"
                              IsChecked="{Binding CheckForUpdates, Mode=TwoWay}"
                              Margin="0,0,0,10" />
                    
                    <CheckBox Content="Send anonymous usage statistics (helps improve Modrix)"
                              IsChecked="{Binding SendUsageStatistics, Mode=TwoWay}"
                              Margin="0,0,0,15" />

                    <!-- Language Selection -->
                    <StackPanel>
                        <TextBlock Text="Interface Language:"
                                   FontSize="14"
                                   Margin="0,0,0,8" />
                        <ComboBox SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                  Width="200"
                                  HorizontalAlignment="Left">
                            <ComboBoxItem Content="English" />
                            <ComboBoxItem Content="Spanish" />
                            <ComboBoxItem Content="French" />
                            <ComboBoxItem Content="German" />
                            <ComboBoxItem Content="Japanese" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- Summary -->
            <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <ui:SymbolIcon Symbol="Info24" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock Text="Installation Summary" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    
                    <TextBlock Text="Ready to install Modrix with the following settings:"
                               FontSize="14"
                               Margin="0,0,0,15" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Location:" FontWeight="SemiBold" Margin="0,0,10,5" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InstallPath}" Margin="0,0,0,5" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Space Required:" FontWeight="SemiBold" Margin="0,0,10,5" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RequiredSpace}" Margin="0,0,0,5" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Shortcuts:" FontWeight="SemiBold" Margin="0,0,10,5" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="Desktop" Visibility="{Binding CreateDesktopShortcut, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,10,0" />
                            <TextBlock Text="Start Menu" Visibility="{Binding CreateStartMenuShortcut, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Language:" FontWeight="SemiBold" Margin="0,0,10,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedLanguage}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
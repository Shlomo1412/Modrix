<Page
    x:Class="ModrixInstaller.Views.Pages.InstallerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ModrixInstaller.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="InstallerPage"
    d:DataContext="{d:DesignInstance local:InstallerPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="650"
    d:DesignWidth="900"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="3,3,12,12" 
                Padding="16,8,16,12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="ArrowDownload24" Width="24" Height="24" Margin="0,0,8,0"/>
                <StackPanel>
                    <TextBlock Text="Modrix Installer" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Configure and install Modrix from GitHub releases" FontSize="12" 
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column -->
            <StackPanel Grid.Column="0">
                <!-- Administrator Warning -->
                <ui:Card x:Name="AdminWarning" Margin="0,0,0,10"
                         Visibility="{Binding ViewModel.IsAdministrator, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverted}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Shield24" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Administrator Required"/>
                        </StackPanel>

                        <Border CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Warning accent -->
                                <Border Grid.Column="0" CornerRadius="8,0,0,8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFB366" Offset="0"/>
                                            <GradientStop Color="#E6943D" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,10,12,10">
                                    <TextBlock Text="Administrator privileges are recommended for installing to Program Files." 
                                              FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:Button 
                                    Grid.Column="2"
                                    Margin="0,0,12,0"
                                    Command="{Binding ViewModel.RequestAdministratorCommand}"
                                    Appearance="Primary"
                                    ToolTip="Run as Administrator"
                                    VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Shield24" />
                                </ui:Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!-- Release Selection -->
                <ui:Card>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="CloudArrowDown24" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Select Release Version"/>
                            <ui:Button 
                                Margin="10,0,0,0"
                                Appearance="Transparent"
                                Command="{Binding ViewModel.LoadReleasesCommand}"
                                IsEnabled="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverted}"
                                ToolTip="Refresh releases">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" Width="16" Height="16" />
                            </ui:Button>
                        </StackPanel>

                        <Border CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Accent -->
                                <Border Grid.Column="0" CornerRadius="8,0,0,8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#4C7DFF" Offset="0"/>
                                            <GradientStop Color="#2850B7" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,10,12,10">
                                    <ui:ProgressRing 
                                        Width="24" Height="24"
                                        Margin="0,6,0,6"
                                        IsIndeterminate="True"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <ComboBox 
                                        x:Name="ReleasesComboBox"
                                        ItemsSource="{Binding ViewModel.Releases}"
                                        SelectedItem="{Binding ViewModel.SelectedRelease}"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverted}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" FontSize="13" />
                                                        <Border 
                                                            Margin="6,0,0,0"
                                                            Padding="4,1"
                                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                            CornerRadius="6"
                                                            Visibility="{Binding IsPrerelease, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock 
                                                                FontSize="9"
                                                                FontWeight="Medium"
                                                                Foreground="White"
                                                                Text="PRE" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock 
                                                        Margin="0,1,0,0"
                                                        FontSize="10" 
                                                        Opacity="0.7"
                                                        Text="{Binding PublishedAt, StringFormat='MMM dd, yyyy'}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <!-- Right Column -->
            <StackPanel Grid.Column="2">
                <!-- Installation Path -->
                <ui:Card Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="Folder24" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Installation Path"/>
                        </StackPanel>

                        <Border CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Accent -->
                                <Border Grid.Column="0" CornerRadius="8,0,0,8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#9C6BFF" Offset="0"/>
                                            <GradientStop Color="#6A46C8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Grid Grid.Column="1" Margin="12,10,12,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:TextBox 
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        Text="{Binding ViewModel.InstallationPath}" />
                                    
                                    <ui:Button 
                                        Grid.Column="1"
                                        Command="{Binding ViewModel.BrowseInstallationPathCommand}"
                                        Appearance="Secondary"
                                        ToolTip="Browse">
                                        <ui:SymbolIcon Symbol="FolderOpen24" Width="16" Height="16" />
                                    </ui:Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!-- Installation Progress -->
                <ui:Card Margin="0,0,0,10" Visibility="{Binding ViewModel.IsInstalling, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="ArrowDownload24" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Installing..."/>
                        </StackPanel>

                        <Border CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Progress accent -->
                                <Border Grid.Column="0" CornerRadius="8,0,0,8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#6EC177" Offset="0"/>
                                            <GradientStop Color="#4A8A52" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,10,12,10">
                                    <ProgressBar 
                                        Height="6"
                                        Margin="0,0,0,8"
                                        Value="{Binding ViewModel.InstallationProgress}" />
                                    
                                    <TextBlock 
                                        FontSize="12"
                                        Text="{Binding ViewModel.InstallationStatus}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!-- Installation Complete -->
                <ui:Card Margin="0,0,0,10" Visibility="{Binding ViewModel.InstallationCompleted, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Installation Complete!"/>
                        </StackPanel>

                        <Border CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Success accent -->
                                <Border Grid.Column="0" CornerRadius="8,0,0,8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#6EC177" Offset="0"/>
                                            <GradientStop Color="#4A8A52" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,10,12,10">
                                    <TextBlock 
                                        Margin="0,0,0,10"
                                        FontSize="12"
                                        Text="Modrix has been successfully installed. You can now launch the application." />
                                    
                                    <ui:Button 
                                        Command="{Binding ViewModel.LaunchModrixCommand}"
                                        Appearance="Primary"
                                        Content="Launch Modrix"
                                        Icon="{ui:SymbolIcon Rocket24}"
                                        HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!-- Install Button -->
                <ui:Card Visibility="{Binding ViewModel.InstallationCompleted, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverted}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="ArrowDownload24" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Ready to Install"/>
                        </StackPanel>

                        <Border CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Install accent -->
                                <Border Grid.Column="0" CornerRadius="8,0,0,8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#4C7DFF" Offset="0"/>
                                            <GradientStop Color="#2850B7" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,10,12,10">
                                    <TextBlock 
                                        Margin="0,0,0,10"
                                        FontSize="12"
                                        Opacity="0.8"
                                        Text="{Binding ViewModel.InstallationStatus}" />

                                    <ui:Button 
                                        Command="{Binding ViewModel.InstallModrixCommand}"
                                        Appearance="Primary"
                                        Content="Install Modrix"
                                        Icon="{ui:SymbolIcon ArrowDownload24}"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="{Binding ViewModel.IsInstalling, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverted}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
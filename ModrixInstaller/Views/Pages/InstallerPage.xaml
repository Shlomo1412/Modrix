<Page
    x:Class="ModrixInstaller.Views.Pages.InstallerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ModrixInstaller.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="InstallerPage"
    d:DataContext="{d:DesignInstance local:InstallerPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="650"
    d:DesignWidth="900"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock 
                FontSize="32" 
                FontWeight="Bold" 
                Text="Modrix Installer" />
            <TextBlock 
                Margin="0,8,0,0"
                FontSize="16" 
                Opacity="0.8"
                Text="Install Modrix from GitHub releases" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <!-- Administrator Warning -->
                <ui:Card x:Name="AdminWarning" Margin="0,0,0,25" 
                         Visibility="{Binding ViewModel.IsAdministrator, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverted}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="Shield24" Margin="0,0,8,0" />
                                <TextBlock FontWeight="SemiBold" Text="Administrator Required" />
                            </StackPanel>
                            <TextBlock Text="Administrator privileges are recommended for installing to Program Files." />
                        </StackPanel>
                        
                        <ui:Button 
                            Grid.Column="1"
                            Command="{Binding ViewModel.RequestAdministratorCommand}"
                            Appearance="Primary"
                            ToolTip="Run as Administrator">
                            <ui:SymbolIcon Symbol="Shield24" />
                        </ui:Button>
                    </Grid>
                </ui:Card>

                <!-- Release Selection -->
                <ui:Card Margin="0,0,0,25">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <ui:SymbolIcon Symbol="CloudArrowDown24" Margin="0,0,8,0" />
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Select Release Version" />
                            <ui:Button 
                                Margin="15,0,0,0"
                                Appearance="Transparent"
                                Command="{Binding ViewModel.LoadReleasesCommand}"
                                IsEnabled="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverted}"
                                ToolTip="Refresh releases">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" />
                            </ui:Button>
                        </StackPanel>

                        <ui:ProgressRing 
                            Width="30" Height="30"
                            Margin="0,10,0,10"
                            IsIndeterminate="True"
                            Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <ComboBox 
                            x:Name="ReleasesComboBox"
                            ItemsSource="{Binding ViewModel.Releases}"
                            SelectedItem="{Binding ViewModel.SelectedRelease}"
                            Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverted}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <Border 
                                                Margin="8,0,0,0"
                                                Padding="6,2"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                CornerRadius="8"
                                                Visibility="{Binding IsPrerelease, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock 
                                                    FontSize="10"
                                                    FontWeight="Medium"
                                                    Foreground="White"
                                                    Text="PRERELEASE" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock 
                                            Margin="0,2,0,0"
                                            FontSize="12" 
                                            Opacity="0.7"
                                            Text="{Binding TagName}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock 
                                                FontSize="11" 
                                                Opacity="0.6"
                                                Text="{Binding PublishedAt, StringFormat='Released: {0:MMM dd, yyyy}'}" />
                                            <TextBlock 
                                                Margin="15,0,0,0"
                                                FontSize="11" 
                                                Opacity="0.6"
                                                Text="{Binding ModrixAsset.FormattedSize, StringFormat='Size: {0}'}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </ui:Card>

                <!-- Installation Path -->
                <ui:Card Margin="0,0,0,25">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <ui:SymbolIcon Symbol="Folder24" Margin="0,0,8,0" />
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Installation Path" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBox 
                                Grid.Column="0"
                                Margin="0,0,10,0"
                                Text="{Binding ViewModel.InstallationPath}" />
                            
                            <ui:Button 
                                Grid.Column="1"
                                Command="{Binding ViewModel.BrowseInstallationPathCommand}"
                                Appearance="Secondary"
                                ToolTip="Browse">
                                <ui:SymbolIcon Symbol="FolderOpen24" />
                            </ui:Button>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Installation Progress -->
                <ui:Card Margin="0,0,0,25" Visibility="{Binding ViewModel.IsInstalling, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,8,0" />
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Installing..." />
                        </StackPanel>

                        <ProgressBar 
                            Height="6"
                            Margin="0,0,0,10"
                            Value="{Binding ViewModel.InstallationProgress}" />
                        
                        <TextBlock 
                            FontSize="14"
                            Text="{Binding ViewModel.InstallationStatus}" />
                    </StackPanel>
                </ui:Card>

                <!-- Installation Complete -->
                <ui:Card Margin="0,0,0,25" Visibility="{Binding ViewModel.InstallationCompleted, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" Margin="0,0,8,0" />
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Installation Complete!" />
                        </StackPanel>

                        <TextBlock 
                            Margin="0,0,0,15"
                            Text="Modrix has been successfully installed. You can now launch the application." />
                        
                        <ui:Button 
                            Command="{Binding ViewModel.LaunchModrixCommand}"
                            Appearance="Primary"
                            ToolTip="Launch">
                            <ui:SymbolIcon Symbol="Rocket24" />
                        </ui:Button>
                    </StackPanel>
                </ui:Card>

                <!-- Install Button -->
                <ui:Card Margin="0,0,0,25" Visibility="{Binding ViewModel.InstallationCompleted, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverted}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Ready to Install" />
                            <TextBlock 
                                Margin="0,4,0,0"
                                Opacity="0.8"
                                Text="{Binding ViewModel.InstallationStatus}" />
                        </StackPanel>

                        <ui:Button 
                            Grid.Column="1"
                            Command="{Binding ViewModel.InstallModrixCommand}"
                            Appearance="Primary"
                            ToolTip="Install"
                            IsEnabled="{Binding ViewModel.IsInstalling, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverted}">
                            <ui:SymbolIcon Symbol="ArrowDownload24" />
                        </ui:Button>
                    </Grid>
                </ui:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
<ui:FluentWindow
    x:Class="ModrixInstaller.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ModrixInstaller.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="820"
    Height="560"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    ExtendsContentIntoTitleBar="True"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    mc:Ignorable="d">

    <ui:FluentWindow.Resources>
        <Storyboard x:Key="ContentFadeIn">
            <DoubleAnimation Storyboard.TargetName="WizardFrame" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35" />
            <DoubleAnimation Storyboard.TargetName="WizardFrame" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="25" To="0" Duration="0:0:0.35" />
        </Storyboard>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Title="{Binding ViewModel.ApplicationTitle}" Grid.Row="0" CloseWindowByDoubleClickOnIcon="True" />

        <Border Grid.Row="1" Margin="20" Padding="10" CornerRadius="12" Background="{DynamicResource ControlFillColorSecondaryBrush}">
            <Frame x:Name="WizardFrame"
                   NavigationUIVisibility="Hidden"
                   Background="Transparent"
                   Content="{Binding ViewModel.CurrentContent}"
                   Opacity="1">
                <Frame.RenderTransform>
                    <TranslateTransform X="0" />
                </Frame.RenderTransform>
                <Frame.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard Storyboard="{StaticResource ContentFadeIn}" />
                    </EventTrigger>
                </Frame.Triggers>
            </Frame>
        </Border>

        <Grid Grid.Row="2" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Column="0" >
                <ui:Button Command="{Binding ViewModel.PreviousCommand}" IsEnabled="{Binding ViewModel.PreviousEnabled}" Appearance="Transparent" ToolTip="Back">
                    <ui:SymbolIcon Symbol="ArrowLeft24" />
                </ui:Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Column="2" >
                <ui:ToggleSwitch Margin="0,0,12,0"
                                 IsChecked="{Binding ViewModel.IsDarkTheme, Mode=TwoWay}"
                                 ToolTip="Toggle theme"
                                 OnContent="Dark Theme" OffContent="Light Theme"/>
                <ui:Button Command="{Binding ViewModel.NextCommand}" IsEnabled="{Binding ViewModel.NextEnabled}" Appearance="Primary" ToolTip="Next" Icon="{ui:SymbolIcon ArrowRight24}"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>

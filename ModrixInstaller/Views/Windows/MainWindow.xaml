<ui:FluentWindow
    x:Class="ModrixInstaller.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ModrixInstaller.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="820"
    Height="560"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    ExtendsContentIntoTitleBar="True"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Title="{Binding ViewModel.ApplicationTitle}" Grid.Row="0" CloseWindowByDoubleClickOnIcon="True" />

        <Border Grid.Row="1" Margin="20" Padding="10" CornerRadius="12" Background="{DynamicResource ControlFillColorSecondaryBrush}">
            <Frame x:Name="WizardFrame"
                   NavigationUIVisibility="Hidden"
                   Background="Transparent"
                   Content="{Binding ViewModel.CurrentContent}" />
        </Border>

        <Grid Grid.Row="2" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Column="0" >
                <ui:Button Command="{Binding ViewModel.PreviousCommand}" IsEnabled="{Binding ViewModel.PreviousEnabled}" Appearance="Transparent" ToolTip="Back">
                    <ui:SymbolIcon Symbol="ArrowLeft24" />
                </ui:Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Column="2" >
                <ui:Button Command="{Binding ViewModel.ToggleThemeCommand}" Appearance="Transparent" ToolTip="Toggle Theme" Margin="0,0,8,0">
                    <ui:SymbolIcon Symbol="WeatherMoon24" />
                </ui:Button>
                <ui:Button Command="{Binding ViewModel.NextCommand}" IsEnabled="{Binding ViewModel.NextEnabled}" Appearance="Primary" ToolTip="Next">
                    <ui:SymbolIcon Symbol="ArrowRight24" />
                </ui:Button>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>

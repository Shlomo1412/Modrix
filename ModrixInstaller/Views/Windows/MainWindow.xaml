<ui:FluentWindow
    x:Class="ModrixInstaller.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:ModrixInstaller.ViewModels.Windows"
    Title="{Binding ApplicationTitle}"
    Width="800"
    Height="600"
    MinWidth="700"
    MinHeight="500"
    d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar
            Grid.Row="0"
            Title="{Binding ApplicationTitle}"
            Icon="{ui:ImageIcon Source='/Assets/wpfui-icon-256.png'}" />

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Steps -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="20,20,20,10">
                        <Image Source="/Assets/wpfui-icon-256.png" 
                               Width="64" Height="64" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10" />
                        <TextBlock Text="Modrix Installer" 
                                   FontSize="18" 
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Setup Wizard" 
                                   FontSize="12" 
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Installation Steps -->
                    <ItemsControl Grid.Row="1" 
                                  ItemsSource="{Binding InstallationSteps}"
                                  Margin="10,0,10,20">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="15,10" 
                                        Margin="0,2"
                                        CornerRadius="4"
                                        Background="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="{Binding Icon}" 
                                                       Margin="0,0,12,0"
                                                       FontSize="16" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" 
                                                       FontWeight="Medium"
                                                       FontSize="14" />
                                            <TextBlock Text="{Binding Description}" 
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ui:SymbolIcon Symbol="Checkmark24" 
                                                       Margin="12,0,0,0"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource SystemAccentColorPrimary}"
                                                       Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Page Content -->
            <Border Grid.Column="1" Background="{DynamicResource ApplicationBackgroundBrush}">
                <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" />
            </Border>
        </Grid>

        <!-- Footer with Navigation Buttons -->
        <Border Grid.Row="2"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left side - Cancel button -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Button Content="Cancel"
                               Command="{Binding CancelCommand}"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon X24}"
                               IsEnabled="{Binding CanCancel}" />
                </StackPanel>

                <!-- Right side - Navigation buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Back"
                               Command="{Binding GoBackCommand}"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon ChevronLeft24}"
                               IsEnabled="{Binding CanGoBack}"
                               Margin="0,0,10,0" />
                    
                    <ui:Button Content="{Binding NextButtonText}"
                               Command="{Binding GoNextCommand}"
                               Appearance="Primary"
                               Icon="{Binding NextButtonIcon}"
                               IsEnabled="{Binding CanGoNext}"
                               MinWidth="100" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
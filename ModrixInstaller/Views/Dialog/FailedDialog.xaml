<ui:FluentWindow x:Class="ModrixInstaller.Views.Dialogs.FailedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Installation Failed"
        Height="420" 
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18" VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="ErrorCircle24" Width="40" Height="40" Margin="0,0,12,0" Foreground="Red"/>
            <StackPanel>
                <TextBlock Text="Installation Failed!" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Something went wrong during installation" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="18" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Common solutions:" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="&#8226; Run the installer as Administrator" Margin="0,0,0,4"/>
                    <TextBlock Text="&#8226; Check if you have enough disk space" Margin="0,0,0,4"/>
                    <TextBlock Text="&#8226; Temporarily disable antivirus software" Margin="0,0,0,4"/>
                    <TextBlock Text="&#8226; Choose a different installation directory" Margin="0,0,0,4"/>
                    <TextBlock Text="&#8226; Check your internet connection"/>
                </StackPanel>
                
                <TextBlock Text="Error details:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource ControlFillColorTertiaryBrush}" CornerRadius="6" Padding="8">
                    <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ErrorDetailsText" Text="{Binding ErrorMessage}" 
                                  FontFamily="Consolas" FontSize="11" 
                                  TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="Try Again" Appearance="Primary" Height="36" Margin="0,0,8,0" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="TryAgain_Click"/>
            <ui:Button Content="Get Help" Height="36" Margin="0,0,8,0" Icon="{ui:SymbolIcon QuestionCircle24}" Click="GetHelp_Click"/>
            <ui:Button Content="Close" Height="36" Icon="{ui:SymbolIcon Dismiss24}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>